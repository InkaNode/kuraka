--- /dev/null
+++ b/src/lib/kuraka.ts
@@ -0,0 +1,34 @@
+/*
+ * SPDX-FileCopyrightText: 2026 InkaNode
+ *
+ * SPDX-License-Identifier: AGPL-3.0-only
+ */
+
+// Kuraka (https://github.com/InkaNode/kuraka) manages these views, so the
+// menu hides them, plus Enterprise-only views, until the user menu toggle is
+// on. Visual only: the server API and permissions are unchanged.
+// frugal: Enterprise views are hidden regardless of edition; a licensed
+// server shows them with the toggle.
+const KURAKA_VIEWS = new Set(['x:Account/User', 'x:Tenant', 'x:Domain', 'x:DkimSignature']);
+const STORAGE_KEY = 'kuraka.showAll';
+
+export function showAllViews(): boolean {
+  try {
+    return localStorage.getItem(STORAGE_KEY) === 'true';
+  } catch {
+    return false;
+  }
+}
+
+export function setShowAllViews(on: boolean): void {
+  try {
+    localStorage.setItem(STORAGE_KEY, String(on));
+  } catch {
+    return;
+  }
+  window.location.reload();
+}
+
+export function isHiddenView(viewName: string, enterprise: boolean): boolean {
+  return !showAllViews() && (enterprise || KURAKA_VIEWS.has(viewName));
+}
