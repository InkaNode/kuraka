 import i18n from 'i18next';
 import { initReactI18next } from 'react-i18next';
 import en from './en.json';
+import es from './es.json';
 
 const RTL_LANGUAGES = ['ar', 'he', 'fa', 'ur'];
 
 i18n.use(initReactI18next).init({
-  resources: { en: { translation: en } },
+  resources: { en: { translation: en }, es: { translation: es } },
   lng: navigator.language?.split('-')[0] || 'en',
   fallbackLng: 'en',
   interpolation: { escapeValue: false },
 });
 
 export function setLocale(locale: string) {
-  const lang = locale.split('_')[0].split('-')[0];
+  // Kuraka: accounts default to en-US, so English falls back to the browser language.
+  const chosen = locale && !/^en([-_]|$)/.test(locale) ? locale : navigator.language || 'en';
+  const lang = chosen.split('_')[0].split('-')[0];
   i18n.changeLanguage(lang);
   const isRtl = RTL_LANGUAGES.includes(lang);
   document.documentElement.dir = isRtl ? 'rtl' : 'ltr';
