 import { useEffect } from 'react';
+import { getKurakaBranding, kurakaBranding } from '@/lib/kurakaBranding';
 
 const APP_NAME = 'Stalwart WebUI';
 
 export function useDocumentTitle(title?: string | null) {
   useEffect(() => {
-    document.title = title ? `${title} · ${APP_NAME}` : APP_NAME;
+    let active = true;
+    const applyTitle = () => {
+      if (!active) return;
+      const name = getKurakaBranding()?.name || APP_NAME;
+      document.title = title ? `${title} · ${name}` : name;
+    };
+    applyTitle();
+    void kurakaBranding.then(applyTitle);
     return () => {
-      document.title = APP_NAME;
+      active = false;
+      document.title = getKurakaBranding()?.name || APP_NAME;
     };
   }, [title]);
 }
