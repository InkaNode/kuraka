diff --git a/src/lib/kurakaBranding.ts b/src/lib/kurakaBranding.ts
new file mode 100644
index 0000000..965524c
--- /dev/null
+++ b/src/lib/kurakaBranding.ts
@@ -0,0 +1,61 @@
+type KurakaBranding = {
+  name?: string;
+  logo?: string;
+  icon?: string;
+  color?: string;
+  disabled?: boolean;
+};
+
+let config: KurakaBranding | null = null;
+
+export function getKurakaBranding(): KurakaBranding | null {
+  return config;
+}
+
+export const kurakaBranding = fetch('/_kuraka/addon/stalwart.json')
+  .then(async (response) => {
+    if (!response.ok) return null;
+    const value: unknown = await response.json();
+    if (!value || typeof value !== 'object' || Array.isArray(value)) return null;
+    const branding = value as KurakaBranding;
+    if (branding.disabled === true) return null;
+    if (
+      (['name', 'logo', 'icon', 'color'] as const).some((key) => {
+        const field = branding[key];
+        return field !== undefined && typeof field !== 'string';
+      })
+    )
+      return null;
+
+    const { color, icon: iconUrl } = branding;
+    if (color && /^#[\da-f]{6}$/i.test(color)) {
+      const channels = [1, 3, 5].map((offset) => {
+        const channel = parseInt(color.slice(offset, offset + 2), 16) / 255;
+        return channel <= 0.04045 ? channel / 12.92 : ((channel + 0.055) / 1.055) ** 2.4;
+      });
+      const luminance = channels[0] * 0.2126 + channels[1] * 0.7152 + channels[2] * 0.0722;
+      const darkLuminance = ((17 / 255 + 0.055) / 1.055) ** 2.4;
+      const foreground =
+        1.05 / (luminance + 0.05) >= (luminance + 0.05) / (darkLuminance + 0.05) ? '#ffffff' : '#111111';
+      const root = document.documentElement;
+      root.style.setProperty('--kuraka-color', color);
+      root.style.setProperty('--kuraka-color-foreground', foreground);
+      root.dataset.kurakaColor = '';
+    }
+    if (iconUrl) {
+      const icons = Array.from(document.querySelectorAll<HTMLLinkElement>('link[rel~="icon"]'));
+      if (!icons.length) {
+        const icon = document.createElement('link');
+        icon.rel = 'icon';
+        document.head.appendChild(icon);
+        icons.push(icon);
+      }
+      icons.forEach((icon) => {
+        icon.href = iconUrl;
+        icon.removeAttribute('type');
+      });
+    }
+    config = branding;
+    return config;
+  })
+  .catch(() => null);
