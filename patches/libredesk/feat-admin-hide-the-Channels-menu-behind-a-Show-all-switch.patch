--- /dev/null
+++ b/frontend/apps/main/src/utils/kuraka.js
@@ -0,0 +1,19 @@
+// Kuraka: Kuraka manages inboxes, so the Channels menu stays hidden until the user menu toggle is on. Visual only: routes and permissions are unchanged.
+const STORAGE_KEY = 'kuraka.showAll'
+
+export function showAll() {
+  try {
+    return localStorage.getItem(STORAGE_KEY) === 'true'
+  } catch {
+    return false
+  }
+}
+
+export function setShowAll(on) {
+  try {
+    localStorage.setItem(STORAGE_KEY, String(on))
+  } catch {
+    return
+  }
+  window.location.reload()
+}
