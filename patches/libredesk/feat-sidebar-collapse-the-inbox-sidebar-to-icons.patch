diff --git a/frontend/apps/main/src/components/sidebar/KurakaSidebarToggle.vue b/frontend/apps/main/src/components/sidebar/KurakaSidebarToggle.vue
new file mode 100644
index 00000000..81b90732
--- /dev/null
+++ b/frontend/apps/main/src/components/sidebar/KurakaSidebarToggle.vue
@@ -0,0 +1,26 @@
+<template>
+  <Button
+    type="button"
+    variant="ghost"
+    size="icon"
+    class="size-8 shrink-0 text-muted-foreground"
+    :aria-label="label"
+    :aria-expanded="open"
+    :title="label"
+    @click="toggleSidebar"
+  >
+    <component :is="open ? PanelLeftClose : PanelLeftOpen" class="size-4" aria-hidden="true" />
+  </Button>
+</template>
+
+<script setup>
+import { computed } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { PanelLeftClose, PanelLeftOpen } from 'lucide-vue-next'
+import { Button } from '@shared-ui/components/ui/button'
+import { useSidebar } from '@shared-ui/components/ui/sidebar'
+
+const { open, toggleSidebar } = useSidebar()
+const { t } = useI18n()
+const label = computed(() => t(open.value ? 'kuraka.collapseSidebar' : 'kuraka.expandSidebar'))
+</script>
