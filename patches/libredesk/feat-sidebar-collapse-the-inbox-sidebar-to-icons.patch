                 >
                   <User />
                   <span class="flex-1 truncate">{{ t('globals.terms.myInbox') }}</span>
@@ -359,6 +361,7 @@ onMounted(() => {
                 <SidebarMenuButton
                   :isActive="isActiveParent('/inboxes/mentioned')"
                   @click="navigateToInbox('mentioned')"
+                  :tooltip="t('globals.terms.mention', 2)"
                 >
                   <AtSign />
                   <span class="flex-1 truncate">
@@ -380,6 +383,7 @@ onMounted(() => {
                 <SidebarMenuButton
                   :isActive="isActiveParent('/inboxes/unassigned')"
                   @click="navigateToInbox('unassigned')"
+                  :tooltip="t('globals.terms.unassigned')"
                 >
                   <UserRoundX />
                   <span class="flex-1 truncate">
@@ -401,6 +405,7 @@ onMounted(() => {
                 <SidebarMenuButton
                   :isActive="isActiveParent('/inboxes/all')"
                   @click="navigateToInbox('all')"
+                  :tooltip="t('globals.messages.all')"
                 >
                   <Inbox />
                   <span class="flex-1 truncate">
@@ -418,7 +423,7 @@ onMounted(() => {
               <!-- Team Inboxes -->
               <Collapsible
                 defaultOpen
-                class="group/collapsible"
+                class="group/collapsible group-data-[collapsible=icon]:hidden"
                 v-if="userTeams.length"
                 v-model:open="teamInboxOpen"
               >
@@ -452,7 +457,7 @@ onMounted(() => {
 
               <!-- Views -->
               <Collapsible
-                class="group/collapsible"
+                class="group/collapsible group-data-[collapsible=icon]:hidden"
                 defaultOpen
                 v-model:open="viewInboxOpen"
                 v-if="userStore.can(permissions.VIEW_MANAGE)"
@@ -524,7 +529,7 @@ onMounted(() => {
 
