From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kuraka <kuraka@localhost>
Date: Wed, 18 Nov 2026 01:02:10 -0500
Subject: [PATCH] feat(sidebar): collapse the inbox sidebar to icons

Kuraka-Severity: normal
Kuraka-Missing-En: Hiding the inbox sidebar removes it completely instead of leaving its icons.
Kuraka-Missing-Es: Al ocultar la barra lateral de la bandeja desaparece por completo en vez de quedar solo con iconos.
---
 .../components/sidebar/KurakaInboxSwitcher.vue    | 14 +++++++-------
 .../apps/main/src/components/sidebar/Sidebar.vue  | 15 ++++++++++-----
 .../src/components/sidebar/SidebarCountBadge.vue  |  2 +-
 .../components/sidebar/SidebarSectionHeader.vue   |  4 ++--
 4 files changed, 20 insertions(+), 15 deletions(-)

diff --git a/frontend/apps/main/src/components/sidebar/KurakaInboxSwitcher.vue b/frontend/apps/main/src/components/sidebar/KurakaInboxSwitcher.vue
index e5d334b6..7056060f 100644
--- a/frontend/apps/main/src/components/sidebar/KurakaInboxSwitcher.vue
+++ b/frontend/apps/main/src/components/sidebar/KurakaInboxSwitcher.vue
@@ -5,11 +5,11 @@
         <div
           tabindex="0"
           aria-disabled="true"
-          class="flex h-10 w-full cursor-default items-center gap-2 rounded-md border border-border px-2 text-left text-sm opacity-80"
+          class="flex h-10 w-full cursor-default items-center gap-2 rounded-md border border-border px-2 group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:px-0 text-left text-sm opacity-80"
         >
           <Mail class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
-          <span class="min-w-0 flex-1 truncate">{{ inboxes[0]?.name ?? t('kuraka.allInboxes') }}</span>
-          <ChevronsUpDown class="size-3.5 shrink-0 opacity-30" aria-hidden="true" />
+          <span class="min-w-0 flex-1 truncate group-data-[collapsible=icon]:hidden">{{ inboxes[0]?.name ?? t('kuraka.allInboxes') }}</span>
+          <ChevronsUpDown class="size-3.5 shrink-0 opacity-30 group-data-[collapsible=icon]:hidden" aria-hidden="true" />
         </div>
       </TooltipTrigger>
       <TooltipContent side="right" class="max-w-60">
@@ -22,12 +22,12 @@
         <button
           type="button"
           :aria-label="t('kuraka.switchInbox')"
-          class="flex h-10 w-full items-center gap-2 rounded-md border border-border px-2 text-left text-sm transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+          class="flex h-10 w-full items-center gap-2 rounded-md border border-border px-2 group-data-[collapsible=icon]:justify-center group-data-[collapsible=icon]:px-0 text-left text-sm transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
         >
           <Mail class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
-          <span class="min-w-0 flex-1 truncate">{{ active?.name ?? t('kuraka.allInboxes') }}</span>
-          <span v-if="!active" class="text-xs tabular-nums text-muted-foreground">{{ inboxes.length }}</span>
-          <ChevronsUpDown class="size-3.5 shrink-0 opacity-50" aria-hidden="true" />
+          <span class="min-w-0 flex-1 truncate group-data-[collapsible=icon]:hidden">{{ active?.name ?? t('kuraka.allInboxes') }}</span>
+          <span v-if="!active" class="text-xs tabular-nums text-muted-foreground group-data-[collapsible=icon]:hidden">{{ inboxes.length }}</span>
+          <ChevronsUpDown class="size-3.5 shrink-0 opacity-50 group-data-[collapsible=icon]:hidden" aria-hidden="true" />
         </button>
       </DropdownMenuTrigger>
       <DropdownMenuContent align="start" class="max-h-[70vh] w-64 overflow-y-auto">
