+  // Refreshes the first page of every status section.
+  async function fetchGroups (listType, teamID, viewID, filters, isStale) {
+    await fetchStatuses()
+    const names = statuses.value.map(s => s.name)
+    const results = await Promise.allSettled(names.map(name =>
+      makeConversationListRequest(listType, teamID, viewID, [...filters, statusFilter(name)], 1)))
+    if (isStale()) return
+    results.forEach((result, i) => {
+      if (result.status === 'fulfilled') processConversationListResponse(result.value, names[i])
+    })
+    const failed = results.find(result => result.status === 'rejected')
+    if (failed && results.every(result => result.status === 'rejected')) throw failed.reason
+  }
+
+  async function fetchNextGroupConversations (status) {
+    const group = groupPages[status]
+    if (!group || group.fetching || !group.hasMore) return
+    group.fetching = true
+    const seq = contextSeq
+    try {
+      const response = await makeConversationListRequest(conversations.listType, conversations.teamID, conversations.viewID,
+        [...conversations.listFilters, statusFilter(status)], group.page + 1)
+      if (seq === contextSeq) processConversationListResponse(response, status)
+    } catch (error) {
+      if (seq === contextSeq) {
+        emitter.emit(EMITTER_EVENTS.SHOW_TOAST, { variant: 'destructive', description: handleHTTPError(error).message })
+      }
+    } finally {
+      group.fetching = false
+    }
+  }
