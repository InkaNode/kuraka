@@ -428,3 +428,32 @@ describe('status display names', () => {
     expect(store.getStatusLabel('Open')).toBe('globals.terms.open')
   })
 })
+
+describe('status groups', () => {
+  it('pages each status on its own and moves totals with live updates', async () => {
+    localStorage.clear()
+    const store = useConversationStore()
+    store.statuses = [{ id: '1', name: 'Open' }, { id: '2', name: 'Closed' }]
+    store.listLayout = 'groups'
+    const page = (results, total, totalPages, p = 1) => ({ data: { data: { results, page: p, total_pages: totalPages, total } } })
+    api.getAllConversations.mockImplementation(({ filters, page: p }) => {
+      const status = JSON.parse(filters).find(f => f.model === 'conversation_statuses').value
+      if (status === 'Closed') return Promise.resolve(page([{ uuid: 'c', status: 'Closed' }], 1, 1))
+      return Promise.resolve(p === 1 ? page([{ uuid: 'a', status: 'Open' }], 2, 2) : page([{ uuid: 'b', status: 'Open' }], 2, 2, 2))
+    })
+
+    await store.fetchConversationsList(false, 'all')
+    expect(api.getAllConversations).toHaveBeenCalledTimes(2)
+    expect(store.conversations.total).toBe(3)
+    expect(store.conversationGroups.map(g => [g.name, g.total, g.hasMore, g.conversations.length]))
+      .toEqual([['Open', 2, true, 1], ['Closed', 1, false, 1]])
+
+    await store.fetchNextGroupConversations('Open')
+    expect(store.conversationGroups[0].conversations.map(c => c.uuid).sort()).toEqual(['a', 'b'])
+    expect(store.conversationGroups[0].hasMore).toBe(false)
+
+    store.mergeConversationUpdate({ uuid: 'a', status: 'Closed' })
+    expect(store.conversationGroups.map(g => g.total)).toEqual([1, 2])
+    localStorage.clear()
+  })
+})
