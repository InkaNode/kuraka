From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Kuraka <kuraka@localhost>
Date: Mon, 23 Nov 2026 21:19:49 -0500
Subject: [PATCH] feat(admin): hide the Channels menu, Kuraka manages inboxes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Kuraka-Severity: normal
Kuraka-Adds-En: The Channels menu is hidden, because Kuraka creates and manages the mail inboxes.
Kuraka-Adds-Es: El menú Canales está oculto, porque Kuraka crea y administra los buzones de correo.
Kuraka-Missing-En: Admin shows the Channels menu, where changes can break the inboxes Kuraka set up.
Kuraka-Missing-Es: Admin muestra el menú Canales, donde un cambio puede romper los buzones que Kuraka configuró.
---
 .../apps/main/src/constants/navigation.js     | 20 -------
 .../conversation/ConversationPlaceholder.vue  |  9 ----
 frontend/apps/main/src/router/index.js        | 52 ++-----------------
 3 files changed, 3 insertions(+), 78 deletions(-)

diff --git a/frontend/apps/main/src/constants/navigation.js b/frontend/apps/main/src/constants/navigation.js
index 9b851242..4cfa2c0a 100644
--- a/frontend/apps/main/src/constants/navigation.js
+++ b/frontend/apps/main/src/constants/navigation.js
@@ -97,26 +97,6 @@ export const adminNavItems = [
       }
     ]
   },
-  {
-    titleKey: 'globals.terms.channel',
-    isTitleKeyPlural: true,
-    children: [
-      {
-        titleKey: 'globals.terms.inbox',
-        href: '/admin/inboxes',
-        createRouteName: 'new-inbox',
-        permission: 'inboxes:manage',
-        isTitleKeyPlural: true,
-        icon: 'Inbox'
-      },
-      {
-        titleKey: 'admin.whatsappTemplates.title',
-        href: '/admin/whatsapp/templates',
-        permission: 'inboxes:manage',
-        icon: 'WhatsApp'
-      }
-    ]
-  },
   {
     titleKey: 'globals.terms.conversation',
     isTitleKeyPlural: true,
diff --git a/frontend/apps/main/src/features/conversation/ConversationPlaceholder.vue b/frontend/apps/main/src/features/conversation/ConversationPlaceholder.vue
index 4aed984e..74cee391 100644
--- a/frontend/apps/main/src/features/conversation/ConversationPlaceholder.vue
+++ b/frontend/apps/main/src/features/conversation/ConversationPlaceholder.vue
@@ -15,15 +15,6 @@
               <span class="flex-1 text-left ml-3 text-foreground">
                 {{ $t('setup.createFirstInbox') }}
               </span>
-              <Button
-                v-if="!hasInboxes"
-                variant="ghost"
-                size="sm"
-                @click="router.push({ name: 'inbox-list' })"
-                class="ml-auto"
-              >
-                {{ $t('globals.messages.setUp') }}
-              </Button>
             </div>
 
             <div class="checklist-item" :class="{ completed: hasAgents, disabled: !hasInboxes }">
diff --git a/frontend/apps/main/src/router/index.js b/frontend/apps/main/src/router/index.js
index c44d871d..a8cfd181 100644
--- a/frontend/apps/main/src/router/index.js
+++ b/frontend/apps/main/src/router/index.js
@@ -336,55 +336,9 @@ const routes = [
               }
             ]
           },
-          {
-            path: 'inboxes',
-            component: () => import('@main/views/admin/inbox/InboxView.vue'),
-            meta: { titleKey: 'globals.terms.inbox', titleCount: 2 },
-            children: [
-              {
-                path: '',
-                name: 'inbox-list',
-                component: () => import('@main/views/admin/inbox/InboxList.vue')
-              },
-              {
-                path: 'new',
-                name: 'new-inbox',
-                component: () => import('@main/views/admin/inbox/NewInbox.vue'),
-                meta: { titleKey: 'inbox.newInbox' }
-              },
-              {
-                path: ':id/edit',
-                props: true,
-                name: 'edit-inbox',
-                component: () => import('@main/views/admin/inbox/EditInbox.vue'),
-                meta: { titleKey: 'inbox.edit' }
-              }
-            ]
-          },
-          {
-            path: 'whatsapp/templates',
-            meta: { titleKey: 'admin.whatsappTemplates.title' },
-            children: [
-              {
-                path: '',
-                name: 'whatsapp-templates',
-                component: () => import('@main/views/admin/whatsapp/WhatsAppTemplateList.vue')
-              },
-              {
-                path: 'new',
-                name: 'whatsapp-template-new',
-                component: () => import('@main/views/admin/whatsapp/CreateEditWhatsAppTemplate.vue'),
-                meta: { titleKey: 'globals.messages.newTemplate' }
-              },
-              {
-                path: ':id/edit',
-                name: 'whatsapp-template-edit',
-                component: () => import('@main/views/admin/whatsapp/CreateEditWhatsAppTemplate.vue'),
-                props: true,
-                meta: { titleKey: 'globals.messages.edit' }
-              }
-            ]
-          },
+          // Kuraka manages mail channels itself.
+          { path: 'inboxes/:rest(.*)*', name: 'inbox-list', redirect: '/admin' },
+          { path: 'whatsapp/:rest(.*)*', redirect: '/admin' },
           {
             path: 'notification',
             component: () => import('@main/features/admin/notification/NotificationSetting.vue'),
