+func TestParseInactivityClose(t *testing.T) {
+	for _, test := range []struct {
+		input string
+		want  time.Duration
+	}{
+		{"", 0},
+		{"1m", time.Minute},
+		{"1h30m", 90 * time.Minute},
+		{"168h", 168 * time.Hour},
+	} {
+		if got, err := ParseInactivityClose(test.input); err != nil || got != test.want {
+			t.Errorf("ParseInactivityClose(%q) = %v, %v; want %v", test.input, got, err, test.want)
+		}
+	}
+	for _, input := range []string{"0s", "-1m", "59.999s", "168h1ns", "7d", "30 minutes", " "} {
+		if _, err := ParseInactivityClose(input); err == nil {
+			t.Errorf("ParseInactivityClose(%q) accepted an invalid duration", input)
+		}
+	}
+}
