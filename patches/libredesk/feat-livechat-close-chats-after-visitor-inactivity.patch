+// ParseInactivityClose returns the configured duration, or zero when closing is disabled.
+func ParseInactivityClose(value string) (time.Duration, error) {
+	if value == "" {
+		return 0, nil
+	}
+	duration, err := time.ParseDuration(value)
+	if err != nil {
+		return 0, err
+	}
+	if duration < time.Minute || duration > 168*time.Hour {
+		return 0, errors.New("inactivity_close must be between 1m and 168h")
+	}
+	return duration, nil
+}
