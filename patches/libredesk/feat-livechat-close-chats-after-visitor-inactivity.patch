+func TestInactiveLiveChatSelection(t *testing.T) {
+	db := testutil.NewDB(t, "inactivity_close")
+	var q queries
+	require.NoError(t, dbutil.ScanSQLFile("queries.sql", &q, db, efs))
+	db.MustExec(`INSERT INTO conversation_statuses (name, category) VALUES ('Waiting', 'open'), ('Follow-up', 'waiting')`)
+
+	var agentID, assistantID, visitorID int64
+	for userType, id := range map[string]*int64{"agent": &agentID, "ai_assistant": &assistantID, "visitor": &visitorID} {
+		require.NoError(t, db.Get(id, `INSERT INTO users (type, first_name, last_name) VALUES ($1, $2, '') RETURNING id`, userType, userType))
+	}
+	newInbox := func(name, channel, config string, enabled bool) int {
+		t.Helper()
+		var id int
+		require.NoError(t, db.Get(&id, `INSERT INTO inboxes (name, channel, config, enabled) VALUES ($1, $2, $3, $4) RETURNING id`, name, channel, config, enabled))
+		return id
+	}
+	const config = `{"inactivity_close":"30m"}`
+	inboxID := newInbox("Chat", "livechat", config, true)
+	disabledID := newInbox("Disabled", "livechat", config, false)
+	emailID := newInbox("Email", "email", config, true)
+	unconfiguredID := newInbox("Unconfigured", "livechat", `{}`, true)
+	offID := newInbox("Off", "livechat", `{"inactivity_close":""}`, true)
+	otherID := newInbox("Other chat", "livechat", config, true)
+
+	type testMessage struct {
+		senderID int64
+		kind     string
+		private  bool
+		at       time.Time
+	}
+	cutoff := time.Now().UTC().Truncate(time.Second)
+	old := cutoff.Add(-time.Second)
+	recent := cutoff.Add(time.Second)
+	agentReply := testMessage{agentID, "outgoing", false, old}
+	insertMessage := func(uuid string, message testMessage) {
+		t.Helper()
+		_, err := db.Exec(`INSERT INTO conversation_messages (conversation_id, type, status, private, sender_id, sender_type, created_at)
+			SELECT c.id, $2::message_type, 'sent', $3::boolean, u.id,
+			       CASE WHEN u.type = 'visitor' THEN 'contact'::message_sender_type ELSE 'agent'::message_sender_type END, $5::timestamptz
+			FROM conversations c JOIN users u ON u.id = $4 WHERE c.uuid = $1`, uuid, message.kind, message.private, message.senderID, message.at)
+		require.NoError(t, err)
+	}
+	newConversation := func(inboxID int, status string, messages ...testMessage) string {
+		t.Helper()
+		var uuid string
+		require.NoError(t, db.Get(&uuid, `INSERT INTO conversations (inbox_id, status_id, contact_id)
+			VALUES ($1, (SELECT id FROM conversation_statuses WHERE name = $2), $3) RETURNING uuid`, inboxID, status, visitorID))
+		for _, message := range messages {
+			insertMessage(uuid, message)
+		}
+		return uuid
+	}
+
+	privateNote := testMessage{agentID, "outgoing", true, recent}
+	activity := testMessage{agentID, "activity", false, recent}
+	agentChat := newConversation(inboxID, "Open", agentReply, privateNote, activity)
+	aiChat := newConversation(inboxID, "Follow-up", testMessage{assistantID, "outgoing", false, old})
+	newConversation(inboxID, "Open", agentReply, testMessage{visitorID, "incoming", false, old}, privateNote, activity)
+	newConversation(inboxID, "Open", testMessage{agentID, "outgoing", false, cutoff})
+	newConversation(inboxID, "Open", testMessage{agentID, "outgoing", false, recent})
+	newConversation(inboxID, "Open", privateNote, activity)
+	for _, status := range []string{"Waiting", "Snoozed", "Resolved", "Closed"} {
+		newConversation(inboxID, status, agentReply)
+	}
+	for _, id := range []int{disabledID, emailID, unconfiguredID, offID, otherID} {
+		newConversation(id, "Open", agentReply)
+	}
+
+	var candidates []inactivityCloseCandidate
+	require.NoError(t, q.GetInactiveLiveChatConversations.Select(&candidates, inboxID, cutoff, "30m"))
+	var selected []string
+	for _, candidate := range candidates {
+		selected = append(selected, candidate.UUID)
+	}
+	require.ElementsMatch(t, []string{agentChat, aiChat}, selected)
+	for _, id := range []int{disabledID, emailID, unconfiguredID} {
+		var excluded []inactivityCloseCandidate
+		require.NoError(t, q.GetInactiveLiveChatConversations.Select(&excluded, id, cutoff, "30m"))
+		require.Empty(t, excluded)
+	}
+	var off []inactivityCloseCandidate
+	require.NoError(t, q.GetInactiveLiveChatConversations.Select(&off, offID, cutoff, ""))
+	require.Empty(t, off)
+
+	// A visitor reply after selection invalidates the pending close.
+	insertMessage(agentChat, testMessage{visitorID, "incoming", false, recent})
+	for _, candidate := range candidates {
+		result, err := q.UpdateConversationStatus.Exec(candidate.UUID, "Closed", time.Time{}, candidate.LastMessageID, candidate.Status, candidate.Duration)
+		require.NoError(t, err)
+		updated, err := result.RowsAffected()
+		require.NoError(t, err)
+		if candidate.UUID == agentChat {
+			require.Zero(t, updated)
+		} else {
+			require.EqualValues(t, 1, updated)
+		}
+	}
+}
