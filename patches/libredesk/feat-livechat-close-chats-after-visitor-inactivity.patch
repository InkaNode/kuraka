+type inactivityCloseCandidate struct {
+	UUID          string `db:"uuid"`
+	Status        string `db:"status"`
+	LastMessageID int64  `db:"last_message_id"`
+	Duration      string `db:"duration"`
+}
+
+// RunInactivityCloser checks for unanswered live chat replies once a minute.
+func (c *Manager) RunInactivityCloser(ctx context.Context, systemUser umodels.User) {
+	ticker := time.NewTicker(time.Minute)
+	defer ticker.Stop()
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+			c.closeInactiveLiveChats(ctx, systemUser)
+		}
+	}
+}
+
+func (c *Manager) closeInactiveLiveChats(ctx context.Context, systemUser umodels.User) {
+	if ctx.Err() != nil {
+		return
+	}
+	inboxes, err := c.inboxStore.GetAll()
+	if err != nil {
+		c.lo.Error("error fetching inboxes for inactivity close", "error", err)
+		return
+	}
+	now := time.Now()
+	for _, inbox := range inboxes {
+		if ctx.Err() != nil {
+			return
+		}
+		if inbox.Channel != livechat.ChannelLiveChat || !inbox.Enabled {
+			continue
+		}
+		var config livechat.Config
+		if err := json.Unmarshal(inbox.Config, &config); err != nil {
+			c.lo.Error("error reading live chat config for inactivity close", "inbox_id", inbox.ID, "error", err)
+			continue
+		}
+		duration, err := livechat.ParseInactivityClose(config.InactivityClose)
+		if err != nil {
+			c.lo.Error("invalid inactivity_close duration", "inbox_id", inbox.ID, "error", err)
+			continue
+		}
+		if duration == 0 {
+			continue
+		}
+
+		var candidates []inactivityCloseCandidate
+		if err := c.q.GetInactiveLiveChatConversations.SelectContext(ctx, &candidates, inbox.ID, now.Add(-duration), config.InactivityClose); err != nil {
+			if ctx.Err() != nil {
+				return
+			}
+			c.lo.Error("error selecting inactive live chats", "inbox_id", inbox.ID, "error", err)
+			continue
+		}
+		for _, candidate := range candidates {
+			if ctx.Err() != nil {
+				return
+			}
+			if err := c.updateConversationStatus(candidate.UUID, 0, models.StatusClosed, "", systemUser, &candidate); err != nil {
+				c.lo.Error("error closing inactive live chat", "conversation_uuid", candidate.UUID, "error", err)
+			}
+		}
+	}
+}
