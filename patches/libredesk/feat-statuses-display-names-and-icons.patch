+import { ref, defineAsyncComponent } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { onClickOutside } from '@vueuse/core'
+import { ImageUp, Loader2, SmilePlus, X } from 'lucide-vue-next'
 import {
   FormControl,
+  FormDescription,
   FormField,
   FormItem,
   FormLabel,
   FormMessage
 } from '@shared-ui/components/ui/form'
 import { Input } from '@shared-ui/components/ui/input'
+import { Button } from '@shared-ui/components/ui/button'
+import StatusIcon from '@shared-ui/components/StatusIcon.vue'
+import { useEmitter } from '@main/composables/useEmitter.js'
+import { EMITTER_EVENTS } from '@main/constants/emitterEvents.js'
+import { handleHTTPError } from '@shared-ui/utils/http.js'
+import api from '@main/api/index.js'
 import {
   Select,
   SelectContent,
@@ -52,4 +143,59 @@ import {
   SelectTrigger,
   SelectValue
 } from '@shared-ui/components/ui/select'
+
+const EmojiPicker = defineAsyncComponent(async () => {
+  const [mod] = await Promise.all([import('vue3-emoji-picker'), import('vue3-emoji-picker/css')])
+  return mod.default
+})
+
+defineProps({
+  isDefault: { type: Boolean, default: false },
+  isEditing: { type: Boolean, default: false }
+})
+
+const { t } = useI18n()
+const emitter = useEmitter()
+const isEmojiPickerVisible = ref(false)
+const emojiPickerContainer = ref(null)
+const fileInput = ref(null)
+const isUploading = ref(false)
+
+onClickOutside(emojiPickerContainer, () => {
+  isEmojiPickerVisible.value = false
+})
+
+const onSelectEmoji = (emoji, setIcon) => {
+  setIcon(emoji.i || emoji)
+  isEmojiPickerVisible.value = false
+}
+
+const onFileSelected = async (event, setIcon) => {
+  const file = event.target.files?.[0]
+  event.target.value = ''
+  if (!file) return
+  if (!file.type.startsWith('image/')) {
+    emitter.emit(EMITTER_EVENTS.SHOW_TOAST, {
+      variant: 'destructive',
+      description: t('status.imageOnly')
+    })
+    return
+  }
+  isUploading.value = true
+  try {
+    const resp = await api.uploadMedia({
+      files: file,
+      inline: false,
+      linked_model: 'conversation_statuses'
+    })
+    setIcon(resp.data.data.url)
+  } catch (error) {
+    emitter.emit(EMITTER_EVENTS.SHOW_TOAST, {
+      variant: 'destructive',
+      description: handleHTTPError(error).message
+    })
+  } finally {
+    isUploading.value = false
+  }
+}
 </script>
