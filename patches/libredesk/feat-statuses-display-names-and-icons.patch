+
+describe('status display fields', () => {
+    test('trims names and counts Unicode characters', () => {
+        const form = schema.parse({ ...validForm, display_name: `  ${'\u754c'.repeat(50)}  `, icon: '\u2705'.repeat(16) })
+        expect(form.display_name).toBe('\u754c'.repeat(50))
+        expect(() => schema.parse({ ...validForm, display_name: '\u754c'.repeat(51) })).toThrow()
+        expect(() => schema.parse({ ...validForm, icon: '\u2705'.repeat(17) })).toThrow()
+    })
+
+    test.each(['https://example.com/a b', '/uploads/"icon', 'bad\nicon'])('rejects invalid icons: %s', icon => {
+        expect(() => schema.parse({ ...validForm, icon })).toThrow()
+    })
+
+    test('allows clearing labels and icons', () => {
+        expect(schema.parse({ ...validForm, display_name: '', icon: '' })).toMatchObject({ display_name: '', icon: '' })
+        expect(() => schema.parse({ ...validForm, display_name: '\tname' })).toThrow()
+    })
+})
