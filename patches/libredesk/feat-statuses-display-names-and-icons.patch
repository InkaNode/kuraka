diff --git a/internal/kuraka/migrate.go b/internal/kuraka/migrate.go
new file mode 100644
index 00000000..2ad954dc
--- /dev/null
+++ b/internal/kuraka/migrate.go
@@ -0,0 +1,28 @@
+// Package kuraka holds Kuraka's additions to Libredesk.
+package kuraka
+
+import "github.com/jmoiron/sqlx"
+
+// Migrate applies Kuraka's schema changes outside upstream's versioned migrations.
+func Migrate(db *sqlx.DB) error {
+	tx, err := db.Beginx()
+	if err != nil {
+		return err
+	}
+	defer tx.Rollback()
+	_, err = tx.Exec(`DO $$ BEGIN
+  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
+   WHERE table_schema = current_schema() AND table_name = 'conversation_statuses' AND column_name = 'icon') THEN
+   ALTER TABLE conversation_statuses
+    ADD COLUMN IF NOT EXISTS display_name TEXT NOT NULL DEFAULT '' CHECK (length(display_name) <= 50),
+    ADD COLUMN IF NOT EXISTS icon TEXT NOT NULL DEFAULT '' CHECK (length(icon) <= 2048);
+   UPDATE conversation_statuses SET icon = CASE name
+    WHEN 'Open' THEN '🟢' WHEN 'Snoozed' THEN '💤' WHEN 'Resolved' THEN '✅' WHEN 'Closed' THEN '🔒' END
+   WHERE name IN ('Open', 'Snoozed', 'Resolved', 'Closed');
+  END IF;
+ END $$`)
+	if err != nil {
+		return err
+	}
+	return tx.Commit()
+}
diff --git a/internal/kuraka/status.go b/internal/kuraka/status.go
new file mode 100644
index 00000000..04759aee
--- /dev/null
+++ b/internal/kuraka/status.go
@@ -0,0 +1,36 @@
+package kuraka
+
+import (
+	"errors"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+)
+
+// ValidateStatus trims and validates the display name and validates the icon.
+// The returned field identifies invalid input for the caller's localized error.
+func ValidateStatus(displayName, icon string) (name, field string) {
+	name = strings.TrimSpace(displayName)
+	if !utf8.ValidString(displayName) || utf8.RuneCountInString(name) > 50 || strings.ContainsFunc(displayName, unicode.IsControl) {
+		return name, "display_name"
+	}
+	if ValidateIcon(icon) != nil {
+		return name, "icon"
+	}
+	return name, ""
+}
+
+// ValidateIcon accepts empty, short text, or an HTTPS or upload URL.
+func ValidateIcon(icon string) error {
+	if !utf8.ValidString(icon) || strings.ContainsFunc(icon, unicode.IsControl) {
+		return errors.New("invalid icon")
+	}
+	if strings.HasPrefix(icon, "https://") || strings.HasPrefix(icon, "/uploads/") {
+		if utf8.RuneCountInString(icon) > 2048 || strings.ContainsFunc(icon, unicode.IsSpace) || strings.ContainsAny(icon, "\"'") {
+			return errors.New("invalid icon")
+		}
+	} else if utf8.RuneCountInString(icon) > 16 {
+		return errors.New("invalid icon")
+	}
+	return nil
+}
diff --git a/internal/kuraka/status_test.go b/internal/kuraka/status_test.go
new file mode 100644
index 00000000..327caf49
--- /dev/null
+++ b/internal/kuraka/status_test.go
@@ -0,0 +1,35 @@
+package kuraka
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestValidateStatus(t *testing.T) {
+	for _, tc := range []struct{ name, icon, want, field string }{
+		{"", "", "", ""},
+		{"  Pendiente  ", "🟢", "Pendiente", ""},
+		{strings.Repeat("界", 50), "", strings.Repeat("界", 50), ""},
+		{strings.Repeat("界", 51), "", strings.Repeat("界", 51), "display_name"},
+		{"bad\nname", "", "bad\nname", "display_name"},
+		{"\tname", "", "name", "display_name"},
+		{"\xff", "", "\xff", "display_name"},
+		{"Name", strings.Repeat("🟢", 16), "Name", ""},
+		{"Name", strings.Repeat("🟢", 17), "Name", "icon"},
+		{"Name", "https://example.com/icon.png", "Name", ""},
+		{"Name", "/uploads/uuid", "Name", ""},
+		{"Name", "https://" + strings.Repeat("a", 2040), "Name", ""},
+		{"Name", "https://" + strings.Repeat("a", 2041), "Name", "icon"},
+		{"Name", "https://example.com/a b", "Name", "icon"},
+		{"Name", "https://example.com/a\u00a0b", "Name", "icon"},
+		{"Name", "/uploads/\"uuid", "Name", "icon"},
+		{"Name", "/uploads/'uuid", "Name", "icon"},
+		{"Name", "bad\nicon", "Name", "icon"},
+		{"Name", "\xff", "Name", "icon"},
+	} {
+		got, field := ValidateStatus(tc.name, tc.icon)
+		if got != tc.want || field != tc.field {
+			t.Errorf("ValidateStatus(%q, %q) = (%q, %q), want (%q, %q)", tc.name, tc.icon, got, field, tc.want, tc.field)
+		}
+	}
+}
