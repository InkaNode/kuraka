--- /dev/null
+++ b/frontend/apps/main/src/utils/contactColor.js
@@ -0,0 +1,21 @@
+// Contacts without a photo get a solid colour picked from their id: 20 hues in
+// two shades, dark enough for white initials. The step is coprime with the
+// palette size, so consecutive ids land far apart and every colour is used
+// equally often.
+const HUES = 20
+const SIZE = HUES * 2
+const STEP = 17
+
+export function contactColorIndex (id) {
+  const n = Number(id)
+  if (!Number.isSafeInteger(n) || n <= 0) return -1
+  return ((n % SIZE) * STEP) % SIZE
+}
+
+export function contactAvatarStyle (id) {
+  const i = contactColorIndex(id)
+  if (i < 0) return undefined
+  const hue = (i % HUES) * (360 / HUES)
+  const color = i < HUES ? `oklch(52% 0.15 ${hue})` : `oklch(42% 0.12 ${hue})`
+  return { backgroundColor: color, backgroundImage: 'none', color: '#fff' }
+}
diff --git a/frontend/apps/main/src/utils/contactColor.test.js b/frontend/apps/main/src/utils/contactColor.test.js
new file mode 100644
index 00000000..0b1383e6
--- /dev/null
+++ b/frontend/apps/main/src/utils/contactColor.test.js
@@ -0,0 +1,20 @@
+import { describe, expect, it } from 'vitest'
+import { contactAvatarStyle, contactColorIndex } from './contactColor'
+
+describe('contactColorIndex', () => {
+  it('uses every colour equally often', () => {
+    const counts = new Array(40).fill(0)
+    for (let id = 1; id <= 400; id++) counts[contactColorIndex(id)]++
+    expect(counts.every((n) => n === 10)).toBe(true)
+  })
+
+  it('is stable and spreads consecutive ids', () => {
+    expect(contactColorIndex(7)).toBe(contactColorIndex(7))
+    expect(contactColorIndex(1)).not.toBe(contactColorIndex(2))
+    expect(contactColorIndex('7')).toBe(contactColorIndex(7))
+  })
+
+  it('has no colour without a valid id', () => {
+    for (const id of [undefined, null, 0, -3, 1.5, 'x']) expect(contactAvatarStyle(id)).toBeUndefined()
+  })
+})
