+package main
+
+import (
+	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/zerodha/fastglue"
+)
+
+// handleChatCloseConversation lets the widget contact end their own conversation.
+func handleChatCloseConversation(r *fastglue.Request) error {
+	var (
+		app              = r.Context.(*App)
+		conversationUUID = r.RequestCtx.UserValue("uuid").(string)
+	)
+
+	_, conversation, err := getContactConversation(r, conversationUUID)
+	if err != nil {
+		return sendErrorEnvelope(r, err)
+	}
+
+	actor, err := app.user.GetSystemUser()
+	if err != nil {
+		return sendErrorEnvelope(r, err)
+	}
+
+	if err := app.conversation.UpdateConversationStatus(conversation.UUID, 0, cmodels.StatusClosed, "", actor); err != nil {
+		return sendErrorEnvelope(r, err)
+	}
+	return r.SendEnvelope(true)
+}
+
