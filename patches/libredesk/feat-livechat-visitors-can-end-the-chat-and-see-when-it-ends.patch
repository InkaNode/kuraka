@@ -0,0 +1,63 @@
+package main
+
+import (
+	"testing"
+
+	"github.com/abhinavxd/libredesk/internal/conversation"
+	imodels "github.com/abhinavxd/libredesk/internal/inbox/models"
+	"github.com/abhinavxd/libredesk/internal/testutil"
+	"github.com/valyala/fasthttp"
+	"github.com/zerodha/fastglue"
+	"github.com/zerodha/logf"
+)
+
+func TestWidgetCloseConversationRejectsWrongContactOrInbox(t *testing.T) {
+	db := testutil.NewDB(t, "widget_close_ownership")
+	lo := logf.New(logf.Opts{})
+	lang := testutil.NewI18n(t)
+	manager, err := conversation.New(nil, lang, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil,
+		conversation.Opts{DB: db, Lo: &lo})
+	if err != nil {
+		t.Fatal(err)
+	}
+	app := &App{conversation: manager, i18n: lang, lo: &lo}
+
+	var ownerID, otherContactID, inboxID, otherInboxID int
+	var uuid string
+	for _, contactID := range []*int{&ownerID, &otherContactID} {
+		if err := db.Get(contactID, `INSERT INTO users (type, first_name, last_name) VALUES ('contact', 'Customer', '') RETURNING id`); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, inboxID := range []*int{&inboxID, &otherInboxID} {
+		if err := db.Get(inboxID, `INSERT INTO inboxes (name, channel) VALUES ('Chat', 'livechat') RETURNING id`); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := db.Get(&uuid, `INSERT INTO conversations (contact_id, inbox_id, status_id)
+		VALUES ($1, $2, (SELECT id FROM conversation_statuses WHERE name = 'Open')) RETURNING uuid`, ownerID, inboxID); err != nil {
+		t.Fatal(err)
+	}
+
+	for _, tc := range []struct {
+		name      string
+		contactID int
+		inboxID   int
+	}{
+		{"wrong contact", otherContactID, inboxID},
+		{"wrong inbox", ownerID, otherInboxID},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := &fasthttp.RequestCtx{}
+			ctx.SetUserValue("uuid", uuid)
+			ctx.SetUserValue(ctxWidgetContactID, tc.contactID)
+			ctx.SetUserValue(ctxWidgetInbox, imodels.Inbox{ID: tc.inboxID})
+			if err := handleChatCloseConversation(&fastglue.Request{RequestCtx: ctx, Context: app}); err != nil {
+				t.Fatal(err)
+			}
+			if status := ctx.Response.StatusCode(); status != fasthttp.StatusForbidden {
+				t.Fatalf("status = %d, want %d", status, fasthttp.StatusForbidden)
+			}
+		})
+	}
+}
