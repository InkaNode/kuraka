@@ -0,0 +1,50 @@
+// @vitest-environment jsdom
+import { describe, test, expect, beforeEach, vi } from 'vitest'
+import { createPinia, setActivePinia } from 'pinia'
+import { useChatStore } from './store/chat.js'
+import { WidgetWebSocketClient } from './websocket.js'
+
+vi.mock('./store/widget.js', () => ({ useWidgetStore: () => ({}) }))
+vi.mock('@shared-ui/composables/useNotificationSound.js', () => ({ playNotificationSound: vi.fn() }))
+
+describe('Widget websocket conversation status', () => {
+  let chatStore
+
+  beforeEach(() => {
+    setActivePinia(createPinia())
+    chatStore = useChatStore()
+    chatStore.addConversationToList({ uuid: 'convo-1', status: 'Open' })
+    chatStore.addConversationToList({ uuid: 'convo-2', status: 'Open' })
+    chatStore.setCurrentConversation({ uuid: 'convo-1', status: 'Open' })
+  })
+
+  const receive = (data) => {
+    const client = new WidgetWebSocketClient()
+    client.socket = {}
+    client.handleMessage({
+      target: client.socket,
+      data: JSON.stringify({ type: 'conversation_update', data })
+    })
+  }
+
+  test.each(['Resolved', 'Closed'])('updates the current conversation and list to %s', (status) => {
+    receive({ uuid: 'convo-1', status })
+
+    expect(chatStore.currentConversation.status).toBe(status)
+    expect(chatStore.isCurrentConversationEnded).toBe(true)
+    expect(chatStore.conversations.find((c) => c.uuid === 'convo-1').status).toBe(status)
+    expect(chatStore.conversations.find((c) => c.uuid === 'convo-2').status).toBe('Open')
+
+    receive({ uuid: 'convo-1', status: 'Open' })
+
+    expect(chatStore.isCurrentConversationEnded).toBe(false)
+    expect(chatStore.conversations.find((c) => c.uuid === 'convo-1').status).toBe('Open')
+  })
+
+  test('updates only the list entry for another conversation', () => {
+    receive({ uuid: 'convo-2', status: 'Resolved' })
+
+    expect(chatStore.currentConversation.status).toBe('Open')
+    expect(chatStore.conversations.find((c) => c.uuid === 'convo-2').status).toBe('Resolved')
+  })
+})
