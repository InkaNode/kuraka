+watch([() => chatStore.currentConversation?.uuid, canEndChat], () => {
+  confirmingEnd.value = false
+})
+
 const emit = defineEmits(['goBack', 'error'])
+const endChat = async () => {
+  if (ending.value || !canEndChat.value) return
+  ending.value = true
+  const conversation = chatStore.currentConversation
+  let statusChanged = false
+  const stopWatchingStatus = watch(
+    () => conversation.status,
+    () => { statusChanged = true },
+    { flush: 'sync' }
+  )
+  try {
+    await api.closeChatConversation(conversation.uuid)
+    if (chatStore.currentConversation === conversation && !statusChanged) {
+      chatStore.updateCurrentConversation({ uuid: conversation.uuid, status: 'Closed' })
+    }
+    confirmingEnd.value = false
+  } catch (error) {
+    emit('error', handleHTTPError(error).message)
+  } finally {
+    stopWatchingStatus()
+    ending.value = false
+  }
+}
