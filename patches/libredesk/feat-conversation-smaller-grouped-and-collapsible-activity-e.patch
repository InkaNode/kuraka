             :data-message-uuid="row.message.uuid"
-            :class="[row.spacingClass, { 'my-2': row.message.type === 'activity' }]"
+            :class="[row.spacingClass, { 'my-2': row.message.type === 'activity' && !row.activityGroup }]"
           >
             <DaySeparator
               v-if="row.showDaySeparator"
@@ -38,7 +39,25 @@
               />
             </div>
             <div v-else-if="row.message.type === 'activity'">
-              <ActivityMessageBubble :message="row.message" />
+              <button
+                v-if="row.firstInGroup && row.activityGroup.size > activityCollapseAfter"
+                type="button"
+                class="mx-auto flex items-center gap-1 rounded-md px-2 py-0.5 text-xs text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+                :aria-expanded="!isCollapsed(row.activityGroup)"
+                @click="toggleGroup(row.activityGroup)"
+              >
+                <ChevronRight
+                  class="size-3.5 transition-transform"
+                  :class="{ 'rotate-90': !isCollapsed(row.activityGroup) }"
+                  aria-hidden="true"
+                />
+                {{
+                  isCollapsed(row.activityGroup)
+                    ? $t('conversation.activity.show', row.activityGroup.size)
+                    : $t('conversation.activity.hide')
