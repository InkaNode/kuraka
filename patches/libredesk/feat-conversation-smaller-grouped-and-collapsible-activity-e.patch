             </div>
           </div>
         </TransitionGroup>
@@ -85,7 +104,8 @@ import MessageBubble from './MessageBubble.vue'
 import ActivityMessageBubble from './ActivityMessageBubble.vue'
 import { useConversationStore } from '@main/stores/conversation'
 import { useUserStore } from '@main/stores/user'
-import { Loader2 } from 'lucide-vue-next'
+import { useAppSettingsStore } from '@main/stores/appSettings'
+import { ChevronRight, Loader2 } from 'lucide-vue-next'
 import ScrollToBottomButton from '@shared-ui/components/ScrollToBottomButton'
 import DaySeparator from '@shared-ui/components/DaySeparator'
 import { isSameDay } from 'date-fns'
@@ -108,6 +128,7 @@ const route = useRoute()
 
 const conversationStore = useConversationStore()
 const userStore = useUserStore()
+const appSettingsStore = useAppSettingsStore()
 const threadEl = ref(null)
 const { height: threadHeight } = useElementSize(threadEl)
 const contentEl = ref(null)
@@ -337,19 +358,49 @@ const fillShortThread = () => {
 
 watch([threadHeight, readReady], fillShortThread, { flush: 'post' })
 
+const sameDay = (a, b) => isSameDay(new Date(a.created_at), new Date(b.created_at))
+
+// Two or more activity events in a row on the same day form a group.
+const inActivityRun = (a, b) => a?.type === 'activity' && b?.type === 'activity' && sameDay(a, b)
+
+const activityCollapseAfter = computed(
+  () => Number(appSettingsStore.settings['app.activity_collapse_after']) || 2
+)
+
+// Groups whose open state the agent flipped from the default, by key.
+const toggledGroups = ref(new Set())
+
+const isCollapsed = (group) =>
+  !!group && (group.size > activityCollapseAfter.value) !== toggledGroups.value.has(group.key)
+
+const toggleGroup = (group) => {
+  const next = new Set(toggledGroups.value)
+  if (!next.delete(group.key)) next.add(group.key)
+  toggledGroups.value = next
+}
+
+watch(() => conversationStore.current?.uuid, () => { toggledGroups.value = new Set() })
+
 const messageRows = computed(() => {
   const messages = conversationStore.conversationMessages
+  let group = null
   return messages.map((message, index) => {
-    const groupWithPrev = canGroup(messages[index - 1], message)
+    const prev = messages[index - 1]
+    const groupWithPrev = canGroup(prev, message)
     const groupWithNext = canGroup(message, messages[index + 1])
+    const inGroup = inActivityRun(prev, message)
+    if (inGroup) group.size++
+    else group = inActivityRun(message, messages[index + 1])
+      ? { key: message.render_key || message.uuid, size: 1 }
+      : null
     return {
       message,
       groupWithPrev,
       groupWithNext,
-      spacingClass: getSpacingClass(index, groupWithPrev),
-      showDaySeparator:
-        index === 0 ||
-        !isSameDay(new Date(messages[index - 1].created_at), new Date(message.created_at))
+      activityGroup: group,
+      firstInGroup: !!group && !inGroup,
+      spacingClass: getSpacingClass(index, groupWithPrev || inGroup),
+      showDaySeparator: index === 0 || !sameDay(prev, message)
     }
   })
 })
