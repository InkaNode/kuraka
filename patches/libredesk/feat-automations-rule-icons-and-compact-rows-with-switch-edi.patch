new file mode 100644
index 00000000..b90cc0f3
--- /dev/null
+++ b/frontend/apps/main/src/components/IconField.vue
@@ -0,0 +1,152 @@
+<template>
+  <div ref="emojiPickerContainer" class="relative flex flex-wrap items-center gap-2">
+    <Button
+      type="button"
+      variant="outline"
+      size="icon"
+      class="shrink-0 font-normal"
+      :aria-label="$t('status.icon')"
+      @click="isEmojiPickerVisible = !isEmojiPickerVisible"
+    >
+      <StatusIcon v-if="modelValue" :icon="modelValue" alone />
+      <SmilePlus v-else class="h-4 w-4" />
+    </Button>
+    <FormControl>
+      <Input
+        type="text"
+        class="min-w-0 flex-1"
+        maxlength="2048"
+        :placeholder="$t('status.iconPlaceholder')"
+        :model-value="modelValue"
+        @update:model-value="setIcon"
+      />
+    </FormControl>
+    <Button
+      type="button"
+      variant="outline"
+      class="shrink-0 gap-2"
+      :aria-label="$t('status.uploadImage')"
+      :title="$t('status.uploadImage')"
+      :disabled="isUploading"
+      @click="fileInput?.click()"
+    >
+      <Loader2 v-if="isUploading" class="h-4 w-4 animate-spin" />
+      <ImageUp v-else class="h-4 w-4" />
+      {{ $t('status.uploadImage') }}
+    </Button>
+    <Button
+      v-if="modelValue"
+      type="button"
+      variant="ghost"
+      size="icon"
+      class="shrink-0"
+      :aria-label="$t('status.clearIcon')"
+      :title="$t('status.clearIcon')"
+      @click="setIcon('')"
+    >
+      <X class="h-4 w-4" />
+    </Button>
+    <input ref="fileInput" type="file" accept="image/*" class="hidden" @change="onFileSelected" />
+    <div v-if="isEmojiPickerVisible" class="absolute left-0 top-full z-10 mt-2">
+      <EmojiPicker :native="true" class="w-[300px]" @select="onSelectEmoji" />
+    </div>
+  </div>
+  <div class="flex flex-wrap gap-1" role="group" :aria-label="$t('status.builtinIcons')">
+    <Button
+      v-for="key in builtinKeys"
+      :key="key"
+      type="button"
+      variant="outline"
+      size="icon"
+      class="size-8"
+      :class="{ 'ring-2 ring-ring': modelValue === key }"
+      :aria-label="key.slice(7)"
+      :title="key.slice(7)"
+      :aria-pressed="modelValue === key"
+      @click="setIcon(key)"
+    >
+      <StatusIcon :icon="key" alone />
+    </Button>
+  </div>
+</template>
+
+<script setup>
+// Kuraka: icon picker (emoji, built-in icon or uploaded image) shared by statuses and automation rules.
+import { ref, defineAsyncComponent } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { onClickOutside } from '@vueuse/core'
+import { ImageUp, Loader2, SmilePlus, X } from 'lucide-vue-next'
+import { FormControl } from '@shared-ui/components/ui/form'
+import { Input } from '@shared-ui/components/ui/input'
+import { Button } from '@shared-ui/components/ui/button'
+import StatusIcon from '@shared-ui/components/StatusIcon.vue'
+import { useEmitter } from '@main/composables/useEmitter.js'
+import { EMITTER_EVENTS } from '@main/constants/emitterEvents.js'
+import { handleHTTPError } from '@shared-ui/utils/http.js'
+import api from '@main/api/index.js'
+
+const EmojiPicker = defineAsyncComponent(async () => {
+  const [mod] = await Promise.all([import('vue3-emoji-picker'), import('vue3-emoji-picker/css')])
+  return mod.default
+})
+
+const props = defineProps({
+  modelValue: { type: String, default: '' },
+  builtinKeys: { type: Array, required: true },
+  // Media model the uploaded image is linked to, e.g. "conversation_statuses".
+  linkedModel: { type: String, required: true }
+})
+const emit = defineEmits(['update:modelValue', 'uploading'])
+
+const { t } = useI18n()
+const emitter = useEmitter()
+const isEmojiPickerVisible = ref(false)
+const emojiPickerContainer = ref(null)
+const fileInput = ref(null)
+const isUploading = ref(false)
+
+onClickOutside(emojiPickerContainer, () => {
+  isEmojiPickerVisible.value = false
+})
+
+const setIcon = (value) => emit('update:modelValue', value)
+
+const onSelectEmoji = (emoji) => {
+  setIcon(emoji.i || emoji)
+  isEmojiPickerVisible.value = false
+}
+
+const setUploading = (value) => {
+  isUploading.value = value
+  emit('uploading', value)
+}
+
+const onFileSelected = async (event) => {
+  const file = event.target.files?.[0]
+  event.target.value = ''
+  if (!file) return
+  if (!file.type.startsWith('image/')) {
+    emitter.emit(EMITTER_EVENTS.SHOW_TOAST, {
+      variant: 'destructive',
+      description: t('status.imageOnly')
+    })
+    return
+  }
+  setUploading(true)
+  try {
+    const resp = await api.uploadMedia({
+      files: file,
+      inline: false,
+      linked_model: props.linkedModel
+    })
+    setIcon(resp.data.data.url)
+  } catch (error) {
+    emitter.emit(EMITTER_EVENTS.SHOW_TOAST, {
+      variant: 'destructive',
+      description: handleHTTPError(error).message
+    })
+  } finally {
+    setUploading(false)
+  }
+}
+</script>
