+package automation
+
+import (
+	"encoding/json"
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/abhinavxd/libredesk/internal/automation/models"
+	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/abhinavxd/libredesk/internal/envelope"
+)
+
+// evaluateTagRule compares whole tag names, ignoring case. equals means exactly
+// the requested tags, no more and no fewer.
+func evaluateTagRule(tags []string, rule models.RuleDetail) bool {
+	if rule.Operator == models.RuleOperatorSet {
+		return len(tags) > 0
+	}
+	if rule.Operator == models.RuleOperatorNotSet {
+		return len(tags) == 0
+	}
+	var requested []string
+	for _, tag := range strings.Split(rule.Value, ",") {
+		if tag = strings.TrimSpace(tag); tag != "" {
+			requested = append(requested, tag)
+		}
+	}
+	if len(requested) == 0 {
+		return false
+	}
+	in := func(list []string) func(string) bool {
+		return func(tag string) bool {
+			return slices.ContainsFunc(list, func(name string) bool { return strings.EqualFold(name, tag) })
+		}
+	}
+	switch rule.Operator {
+	case models.RuleOperatorContains:
+		return slices.ContainsFunc(requested, in(tags))
+	case models.RuleOperatorNotContains:
+		return !slices.ContainsFunc(requested, in(tags))
+	case models.RuleOperatorEquals:
+		for _, tag := range requested {
+			if !in(tags)(tag) {
+				return false
+			}
+		}
+		for _, tag := range tags {
+			if !in(requested)(tag) {
+				return false
+			}
+		}
+		return true
+	}
+	return false
+}
+
+func (e *Engine) evaluateTagCondition(conversation cmodels.Conversation, rule models.RuleDetail, previousValues map[string]string) bool {
+	var tags []string
+	if rule.Field == models.ConversationTags {
+		if conversation.Tags.Valid {
+			if err := json.Unmarshal(conversation.Tags.JSON, &tags); err != nil {
+				e.lo.Error("error unmarshalling conversation tags", "error", err)
+				return false
+			}
+		}
+	} else {
+		value, ok := previousValues[rule.Field]
+		if !ok {
+			return false
+		}
+		if value != "" {
+			tags = strings.Split(value, ",")
+		}
+	}
+	return evaluateTagRule(tags, rule)
+}
+
+// validateRuleFields is shared by both save paths. Custom attribute keys are
+// user-defined, as with the existing contact custom attributes.
+func validateRuleFields(record models.RuleRecord) error {
+	invalid := func(message string) error {
+		return envelope.NewError(envelope.InputError, message, nil)
+	}
+	if !slices.Contains([]string{models.RuleTypeNewConversation, models.RuleTypeConversationUpdate, models.RuleTypeTimeTrigger}, record.Type) {
+		return invalid("invalid automation rule type")
+	}
+	for _, event := range record.Events {
+		if !slices.Contains([]string{models.EventConversationUserAssigned, models.EventConversationTeamAssigned,
+			models.EventConversationStatusChange, models.EventConversationPriorityChange,
+			models.EventConversationMessageOutgoing, models.EventConversationMessageIncoming,
+			models.EventConversationTagsChange}, event) {
+			return invalid(fmt.Sprintf("invalid automation event %q", event))
+		}
+	}
+	var rules []models.Rule
+	if err := json.Unmarshal(record.Rules, &rules); err != nil {
+		return invalid("invalid automation rules JSON")
+	}
+	for _, rule := range rules {
+		for _, group := range rule.Groups {
+			for _, condition := range group.Rules {
+				switch condition.FieldType {
+				case "", models.FieldTypeConversationField:
+					if !slices.Contains([]string{models.ConversationSubject, models.ConversationContent,
+						models.ConversationStatus, models.ConversationPriority, models.ConversationAssignedUser,
+						models.ConversationAssignedTeam, models.ConversationInbox, models.ConversationIncomingTo,
+						models.ContactEmail, models.ContactName, models.ContactPhone, models.ConversationChannel,
+						models.ConversationTags, models.ConversationTagsAdded, models.ConversationTagsRemoved,
+						models.ConversationPreviousStatus, models.ConversationPreviousPriority,
+						models.ConversationPreviousAssignedUser, models.ConversationPreviousAssignedTeam,
+						models.ConversationHoursSinceCreated, models.ConversationHoursSinceFirstReply,
+						models.ConversationHoursSinceLastReply, models.ConversationHoursSinceResolved,
+						models.ConversationHoursSinceLastResolved}, condition.Field) {
+						return invalid(fmt.Sprintf("invalid automation field %q", condition.Field))
+					}
+					if condition.Field == models.ConversationTagsAdded || condition.Field == models.ConversationTagsRemoved {
+						if record.Type != models.RuleTypeConversationUpdate {
+							return invalid("tag changes require a conversation_update rule")
+						}
+					}
+					if condition.Field == models.ConversationTags || condition.Field == models.ConversationTagsAdded || condition.Field == models.ConversationTagsRemoved {
+						if !slices.Contains([]string{models.RuleOperatorContains, models.RuleOperatorNotContains, models.RuleOperatorEquals, models.RuleOperatorSet, models.RuleOperatorNotSet}, condition.Operator) {
+							return invalid("invalid tag operator")
+						}
+					}
+					if condition.Field == models.ConversationChannel {
+						if condition.Operator != models.RuleOperatorEquals && condition.Operator != models.RuleOperatorNotEqual {
+							return invalid("invalid channel operator")
+						}
+					}
+				case models.FieldTypeContactCustomAttribute, models.FieldTypeConversationCustomAttribute:
+					if strings.TrimSpace(condition.Field) == "" {
+						return invalid("empty custom attribute key")
+					}
+				default:
+					return invalid(fmt.Sprintf("invalid automation field type %q", condition.FieldType))
+				}
+				if !slices.Contains([]string{models.RuleOperatorContains, models.RuleOperatorNotContains,
+					models.RuleOperatorEquals, models.RuleOperatorNotEqual, models.RuleOperatorSet,
+					models.RuleOperatorNotSet, models.RuleOperatorGreaterThan, models.RuleOperatorLessThan,
+					models.RuleOperatorStartsWith}, condition.Operator) {
+					return invalid(fmt.Sprintf("invalid automation operator %q", condition.Operator))
+				}
+			}
+		}
+	}
+	return nil
+}
