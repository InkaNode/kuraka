+package automation
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/abhinavxd/libredesk/internal/automation/models"
+	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/mock"
+	"github.com/volatiletech/null/v9"
+)
+
+func TestTagConditions(t *testing.T) {
+	engine := createTestEngine(new(mockConversationStore))
+	for _, tc := range []struct {
+		name, operator, value string
+		tags                  []string
+		want                  bool
+	}{
+		{"any", "contains", "missing, vip", []string{"VIP", "Billing"}, true},
+		{"any missing", "contains", "missing, other", []string{"VIP"}, false},
+		{"none", "not contains", "missing, other", []string{"VIP"}, true},
+		{"none excludes any", "not contains", "missing, vip", []string{"VIP"}, false},
+		{"exact", "equals", "vip, BILLING", []string{"Billing", "VIP"}, true},
+		{"exact rejects extra", "equals", "vip, BILLING", []string{"VIP", "Billing", "Extra"}, false},
+		{"exact rejects empty", "equals", "vip", nil, false},
+		{"all requires every name", "equals", "vip, missing", []string{"VIP"}, false},
+		{"whole name", "contains", "vip", []string{"VIP customer"}, false},
+		{"whole name none", "not contains", "vip", []string{"VIP customer"}, true},
+		{"whole name all", "equals", "vip", []string{"VIP customer"}, false},
+		{"spaces in name", "equals", " vip customer ", []string{"VIP Customer"}, true},
+		{"set", "set", "", []string{"VIP"}, true},
+		{"set empty", "set", "", nil, false},
+		{"not set", "not set", "", nil, true},
+		{"not set populated", "not set", "", []string{"VIP"}, false},
+		{"empty contains", "contains", " , ", []string{"VIP"}, false},
+		{"empty none", "not contains", "", []string{"VIP"}, false},
+		{"empty all", "equals", "", []string{"VIP"}, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			data, err := json.Marshal(tc.tags)
+			assert.NoError(t, err)
+			conv := cmodels.Conversation{Tags: null.JSONFrom(data)}
+			for _, field := range []string{models.ConversationTags, models.ConversationTagsAdded, models.ConversationTagsRemoved} {
+				values := map[string]string{field: ""}
+				for i, tag := range tc.tags {
+					if i > 0 {
+						values[field] += ","
+					}
+					values[field] += tag
+				}
+				rule := models.RuleDetail{Field: field, Operator: tc.operator, Value: tc.value, CaseSensitiveMatch: true}
+				assert.Equal(t, tc.want, engine.evaluateRule(rule, conv, values), field)
+			}
+		})
+	}
+}
+
+func TestTagEventAbsentKeys(t *testing.T) {
+	engine := createTestEngine(new(mockConversationStore))
+	for _, field := range []string{models.ConversationTagsAdded, models.ConversationTagsRemoved} {
+		for _, op := range []string{"contains", "not contains", "equals", "set", "not set"} {
+			rule := models.RuleDetail{Field: field, Operator: op, Value: "VIP"}
+			assert.False(t, engine.evaluateRule(rule, cmodels.Conversation{}, nil), "%s %s", field, op)
+			assert.False(t, engine.evaluateRule(rule, cmodels.Conversation{}, map[string]string{"previous_status": "1"}), "%s %s", field, op)
+		}
+		assert.True(t, engine.evaluateRule(models.RuleDetail{Field: field, Operator: "not set"}, cmodels.Conversation{}, map[string]string{field: ""}))
+	}
+}
+
+func TestAdditionalConditions(t *testing.T) {
+	engine := createTestEngine(new(mockConversationStore))
+	conv := cmodels.Conversation{
+		InboxChannel:     "whatsapp",
+		CustomAttributes: json.RawMessage(`{"plan":"Pro","seats":5,"active":true}`),
+		Contact:          cmodels.ConversationContact{FirstName: "Ana", LastName: "Ruiz", PhoneNumber: null.StringFrom("+51999123456"), CustomAttributes: json.RawMessage(`{"plan":"Free"}`)},
+	}
+	for _, rule := range []models.RuleDetail{
+		{Field: models.ContactName, Operator: "equals", Value: "ana ruiz"},
+		{Field: models.ContactPhone, Operator: "starts with", Value: "+51"},
+		{Field: models.ConversationChannel, Operator: "equals", Value: "whatsapp"},
+		{Field: models.ConversationChannel, Operator: "not equals", Value: "email"},
+		{FieldType: models.FieldTypeConversationCustomAttribute, Field: "plan", Operator: "equals", Value: "pro"},
+		{FieldType: models.FieldTypeConversationCustomAttribute, Field: "seats", Operator: "greater than", Value: "4"},
+		{FieldType: models.FieldTypeConversationCustomAttribute, Field: "active", Operator: "equals", Value: "true"},
+		{FieldType: models.FieldTypeConversationCustomAttribute, Field: "absent", Operator: "not set"},
+		{FieldType: models.FieldTypeContactCustomAttribute, Field: "plan", Operator: "equals", Value: "free"},
+	} {
+		assert.True(t, engine.evaluateRule(rule, conv, nil), "%+v", rule)
+	}
+	assert.False(t, engine.evaluateRule(models.RuleDetail{FieldType: models.FieldTypeConversationCustomAttribute, Field: "absent", Operator: "not equals", Value: "x"}, conv, nil))
+	conv.CustomAttributes = json.RawMessage(`invalid`)
+	assert.False(t, engine.evaluateRule(models.RuleDetail{FieldType: models.FieldTypeConversationCustomAttribute, Field: "plan", Operator: "set"}, conv, nil))
+}
+
+func TestTagActionsDoNotRequeue(t *testing.T) {
+	for _, action := range []string{models.ActionAddTags, models.ActionSetTags, models.ActionRemoveTags} {
+		t.Run(action, func(t *testing.T) {
+			store := new(mockConversationStore)
+			engine := createQueueTestEngine(store)
+			conv := createTestConversation()
+			rule := createTestRule([]models.RuleGroup{{LogicalOp: models.OperatorAnd, Rules: []models.RuleDetail{{Field: models.ConversationStatus, Operator: "set"}}}}, []models.RuleAction{{Type: action, Value: []string{"VIP"}}}, models.OperatorAnd)
+			store.On("ApplyAction", mock.Anything, mock.Anything, mock.Anything).Run(func(mock.Arguments) {
+				engine.EvaluateConversationUpdateRules(conv, models.EventConversationTagsChange, map[string]string{models.ConversationTagsAdded: "VIP"}, systemActor())
+				engine.EvaluateConversationUpdateRules(conv, models.EventConversationTagsChange, nil, agentActor())
+			}).Return(nil)
+			engine.evalConversationRules([]models.Rule{rule}, conv, nil)
+			assert.Equal(t, 1, store.callCount)
+			assert.Len(t, engine.taskQueue, 1, "only the concurrent agent event survives suppression")
+			assert.False(t, engine.isSuppressed(conv.UUID))
+		})
+	}
+}
+
+func TestRuleFieldValidation(t *testing.T) {
+	for _, tc := range []struct {
+		field, fieldType, operator, event, ruleType string
+		valid                                       bool
+	}{
+		{"tags", "conversation", "equals", models.EventConversationTagsChange, "conversation_update", true},
+		{"tags_added", "conversation", "not set", models.EventConversationTagsChange, "conversation_update", true},
+		{"tags_removed", "", "contains", models.EventConversationTagsChange, "conversation_update", true},
+		{"contact_name", "", "contains", "", "new_conversation", true},
+		{"contact_phone", "", "starts with", "", "time_trigger", true},
+		{"channel", "", "not equals", "", "new_conversation", true},
+		{"plan", models.FieldTypeConversationCustomAttribute, "equals", "", "new_conversation", true},
+		{"plan", models.FieldTypeContactCustomAttribute, "equals", "", "new_conversation", true},
+		{"unknown", "conversation", "equals", "", "new_conversation", false},
+		{"tags", "unknown", "equals", "", "new_conversation", false},
+		{"tags", "", "contains", "unknown", "conversation_update", false},
+		{"tags", "", "unknown", "", "new_conversation", false},
+		{"tags", "", "starts with", "", "new_conversation", false},
+		{"channel", "", "contains", "", "new_conversation", false},
+		{"tags_added", "", "contains", "", "new_conversation", false},
+		{"tags_removed", "", "not set", "", "time_trigger", false},
+	} {
+		rules, err := json.Marshal([]models.Rule{{Groups: []models.RuleGroup{{Rules: []models.RuleDetail{{Field: tc.field, FieldType: tc.fieldType, Operator: tc.operator}}}}}})
+		assert.NoError(t, err)
+		record := models.RuleRecord{Type: tc.ruleType, Rules: rules}
+		if tc.event != "" {
+			record.Events = []string{tc.event}
+		}
+		assert.Equal(t, tc.valid, validateRuleFields(record) == nil, "%+v", tc)
+	}
+}
