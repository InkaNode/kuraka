+package conversation
+
+import (
+	"testing"
+
+	amodels "github.com/abhinavxd/libredesk/internal/automation/models"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestTagChanges(t *testing.T) {
+	assert.Nil(t, tagChanges(nil, nil))
+	assert.Nil(t, tagChanges([]string{"VIP", "Billing"}, []string{"Billing", "VIP"}))
+	assert.Equal(t, map[string]string{amodels.ConversationTagsAdded: "New", amodels.ConversationTagsRemoved: "Old"}, tagChanges([]string{"VIP", "Old"}, []string{"New", "VIP"}))
+	assert.Equal(t, map[string]string{amodels.ConversationTagsAdded: "", amodels.ConversationTagsRemoved: "VIP"}, tagChanges([]string{"VIP"}, nil))
+	assert.Equal(t, map[string]string{amodels.ConversationTagsAdded: "VIP", amodels.ConversationTagsRemoved: ""}, tagChanges(nil, []string{"VIP"}))
+}
