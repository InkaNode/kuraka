+package conversation
+
+import (
+	"slices"
+	"strings"
+
+	amodels "github.com/abhinavxd/libredesk/internal/automation/models"
+	"github.com/abhinavxd/libredesk/internal/conversation/models"
+	umodels "github.com/abhinavxd/libredesk/internal/user/models"
+)
+
+func tagChanges(previous, current []string) map[string]string {
+	var added, removed []string
+	for _, tag := range current {
+		if !slices.Contains(previous, tag) {
+			added = append(added, tag)
+		}
+	}
+	for _, tag := range previous {
+		if !slices.Contains(current, tag) {
+			removed = append(removed, tag)
+		}
+	}
+	if len(added) == 0 && len(removed) == 0 {
+		return nil
+	}
+	return map[string]string{
+		amodels.ConversationTagsAdded:   strings.Join(added, ","),
+		amodels.ConversationTagsRemoved: strings.Join(removed, ","),
+	}
+}
+
+func (c *Manager) evaluateTagChanges(conversation models.Conversation, previous, current []string, actor umodels.User) {
+	if changes := tagChanges(previous, current); changes != nil {
+		// Synchronous dispatch retains the system actor and the engine's suppression window.
+		c.automation.EvaluateConversationUpdateRules(conversation, amodels.EventConversationTagsChange, changes, actor)
+	}
+}
