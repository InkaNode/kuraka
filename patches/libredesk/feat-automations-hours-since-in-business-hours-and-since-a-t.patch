+++ b/internal/sla/kuraka_test.go
@@ -0,0 +1,49 @@
+package sla
+
+import (
+	"testing"
+	"time"
+
+	"github.com/abhinavxd/libredesk/internal/business_hours/models"
+	"github.com/stretchr/testify/assert"
+)
+
+func TestBusinessMinutesBetween(t *testing.T) {
+	weekdays := models.BusinessHours{
+		Hours: mustMarshalJSON(map[string]models.WorkingHours{
+			"Monday": {Open: "09:00", Close: "17:00"}, "Tuesday": {Open: "09:00", Close: "17:00"},
+			"Wednesday": {Open: "09:00", Close: "17:00"}, "Thursday": {Open: "09:00", Close: "17:00"},
+			"Friday": {Open: "09:00", Close: "17:00"},
+		}),
+		Holidays: mustMarshalJSON([]models.Holiday{{Date: "2023-10-11"}}),
+	}
+	at := func(day, hour, minute int) time.Time { return time.Date(2023, 10, day, hour, minute, 0, 0, time.UTC) }
+
+	tests := []struct {
+		name       string
+		start, end time.Time
+		hours      models.BusinessHours
+		want       int
+	}{
+		{"always open", at(10, 20, 0), at(11, 2, 0), models.BusinessHours{IsAlwaysOpen: true}, 360},
+		{"same working day", at(9, 10, 0), at(9, 12, 30), weekdays, 150},
+		{"before opening to after closing", at(9, 6, 0), at(9, 20, 0), weekdays, 480},
+		{"overnight counts only open time", at(9, 16, 0), at(10, 10, 0), weekdays, 120},
+		{"holiday skipped", at(10, 16, 0), at(12, 10, 0), weekdays, 120},
+		{"weekend skipped", at(13, 16, 0), at(16, 10, 0), weekdays, 120},
+		{"closed the whole time", at(14, 8, 0), at(15, 20, 0), weekdays, 0},
+		{"end before start", at(10, 12, 0), at(9, 12, 0), weekdays, 0},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := businessMinutesBetween(tt.start, tt.end, tt.hours, "UTC")
+			assert.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+
+	// Working hours are read in the business time zone.
+	got, err := businessMinutesBetween(at(9, 15, 0), at(9, 20, 0), weekdays, "America/Lima")
+	assert.NoError(t, err)
+	assert.Equal(t, 300, got) // 15:00 to 20:00 UTC is 10:00 to 15:00 in Lima.
+}
