@@ -0,0 +1,94 @@
+package automation
+
+import (
+	"encoding/json"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/abhinavxd/libredesk/internal/automation/models"
+	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/stretchr/testify/assert"
+	"github.com/volatiletech/null/v9"
+)
+
+type fakeBusinessHours struct {
+	minutes int
+	err     error
+	teamID  int
+}
+
+func (f *fakeBusinessHours) ElapsedBusinessMinutes(teamID int, start, end time.Time) (int, error) {
+	f.teamID = teamID
+	return f.minutes, f.err
+}
+
+func TestHoursSinceBusinessHours(t *testing.T) {
+	conversation := cmodels.Conversation{CreatedAt: time.Now().Add(-48 * time.Hour), AssignedTeamID: null.IntFrom(7)}
+	rule := models.RuleDetail{Field: models.ConversationHoursSinceCreated, Operator: models.RuleOperatorLessThan, Value: "10", BusinessHours: true}
+
+	engine := createTestEngine(new(mockConversationStore))
+	assert.False(t, engine.evaluateRule(rule, conversation, nil), "no business hours store")
+
+	hours := &fakeBusinessHours{minutes: 9 * 60}
+	engine.SetBusinessHoursStore(hours)
+	assert.True(t, engine.evaluateRule(rule, conversation, nil), "9 business hours < 10")
+	assert.Equal(t, 7, hours.teamID)
+
+	rule.BusinessHours = false
+	assert.False(t, engine.evaluateRule(rule, conversation, nil), "48 calendar hours")
+
+	rule.BusinessHours = true
+	hours.err = errors.New("business hours not configured")
+	assert.False(t, engine.evaluateRule(rule, conversation, nil), "error never matches")
+}
+
+func TestHoursSinceTagAdded(t *testing.T) {
+	store := &mockConversationStore{tagsAddedAt: map[string]time.Time{"waiting": time.Now().Add(-30 * time.Hour)}}
+	engine := createTestEngine(store)
+	conversation := cmodels.Conversation{ID: 1}
+	for _, tc := range []struct {
+		tag, operator, value string
+		want                 bool
+	}{
+		{"Waiting", models.RuleOperatorGreaterThan, "24", true},
+		{"waiting", models.RuleOperatorLessThan, "24", false},
+		{"waiting", models.RuleOperatorSet, "", true},
+		{"other", models.RuleOperatorNotSet, "", true},
+		{"other", models.RuleOperatorSet, "", false},
+		{"other", models.RuleOperatorLessThan, "24", false},
+		{"other", models.RuleOperatorGreaterThan, "-1", false},
+	} {
+		rule := models.RuleDetail{Field: models.ConversationHoursSinceTagAdded, Operator: tc.operator, Value: tc.value, Tag: tc.tag}
+		assert.Equal(t, tc.want, engine.evaluateRule(rule, conversation, nil), "%+v", tc)
+	}
+}
+
+func TestHoursSinceValidation(t *testing.T) {
+	for _, tc := range []struct {
+		detail models.RuleDetail
+		valid  bool
+	}{
+		{models.RuleDetail{Field: models.ConversationHoursSinceTagAdded, Operator: "greater than", Value: "4", Tag: "vip"}, true},
+		{models.RuleDetail{Field: models.ConversationHoursSinceTagAdded, Operator: "greater than", Value: "4", Tag: " "}, false},
+		{models.RuleDetail{Field: models.ConversationHoursSinceLastReply, Operator: "greater than", Value: "4", BusinessHours: true}, true},
+		{models.RuleDetail{Field: models.ConversationSubject, Operator: "equals", Value: "x", BusinessHours: true}, false},
+		{models.RuleDetail{Field: models.ConversationHoursSinceCreated, FieldType: models.FieldTypeContactCustomAttribute, Operator: "equals", BusinessHours: true}, false},
+	} {
+		rules, err := json.Marshal([]models.Rule{{Groups: []models.RuleGroup{{Rules: []models.RuleDetail{tc.detail}}}}})
+		assert.NoError(t, err)
+		record := models.RuleRecord{Type: models.RuleTypeTimeTrigger, Rules: rules}
+		assert.Equal(t, tc.valid, validateRuleFields(record) == nil, "%+v", tc.detail)
+	}
+}
+
+func TestHoursSinceMissingMoment(t *testing.T) {
+	engine := createTestEngine(new(mockConversationStore))
+	conversation := cmodels.Conversation{CreatedAt: time.Now()}
+	for _, field := range []string{models.ConversationHoursSinceFirstReply, models.ConversationHoursSinceLastReply, models.ConversationHoursSinceResolved} {
+		for operator, want := range map[string]bool{models.RuleOperatorLessThan: false, models.RuleOperatorEquals: false, models.RuleOperatorNotSet: true, models.RuleOperatorSet: false} {
+			rule := models.RuleDetail{Field: field, Operator: operator, Value: "24"}
+			assert.Equal(t, want, engine.evaluateRule(rule, conversation, nil), "%s %s", field, operator)
+		}
+	}
+}
