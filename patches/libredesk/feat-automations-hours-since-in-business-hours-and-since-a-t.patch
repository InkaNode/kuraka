+package sla
+
+import (
+	"encoding/json"
+	"fmt"
+	"time"
+
+	"github.com/abhinavxd/libredesk/internal/business_hours/models"
+)
+
+// ElapsedBusinessMinutes counts the working minutes between start and end in the business hours
+// of the team, or the default ones when the team has none.
+// frugal: one business hours lookup per call; cache it per time trigger run if many conversations use it.
+func (m *Manager) ElapsedBusinessMinutes(teamID int, start, end time.Time) (int, error) {
+	businessHours, timeZone, err := m.getBusinessHoursAndTimezone(teamID)
+	if err != nil {
+		return 0, err
+	}
+	return businessMinutesBetween(start, end, businessHours, timeZone)
+}
+
+// businessMinutesBetween is the working time between start and end, skipping holidays and closed days.
+func businessMinutesBetween(start, end time.Time, businessHours models.BusinessHours, timeZone string) (int, error) {
+	if !end.After(start) {
+		return 0, nil
+	}
+	if businessHours.IsAlwaysOpen {
+		return int(end.Sub(start).Minutes()), nil
+	}
+	loc, err := time.LoadLocation(timeZone)
+	if err != nil {
+		return 0, fmt.Errorf("invalid time zone %s: %v", timeZone, err)
+	}
+	var workingHours map[string]models.WorkingHours
+	if err := json.Unmarshal(businessHours.Hours, &workingHours); err != nil {
+		return 0, fmt.Errorf("could not unmarshal working hours: %v", err)
+	}
+	var holidays []models.Holiday
+	if len(businessHours.Holidays) > 0 {
+		if err := json.Unmarshal(businessHours.Holidays, &holidays); err != nil {
+			return 0, fmt.Errorf("could not unmarshal holidays: %v", err)
+		}
+	}
+	isHoliday := make(map[string]bool, len(holidays))
+	for _, holiday := range holidays {
+		isHoliday[holiday.Date] = true
+	}
+
+	start, end = start.In(loc), end.In(loc)
+	var elapsed time.Duration
+	for day := time.Date(start.Year(), start.Month(), start.Day(), 0, 0, 0, 0, loc); day.Before(end); day = nextDay(day, loc) {
+		hours, open := workingHours[day.Weekday().String()]
+		if !open || isHoliday[day.Format(time.DateOnly)] {
+			continue
+		}
+		opensAt, err := parseTime(day, hours.Open, loc)
+		if err != nil {
+			return 0, fmt.Errorf("invalid open time %s: %v", hours.Open, err)
+		}
+		closesAt, err := parseTime(day, hours.Close, loc)
+		if err != nil {
+			return 0, fmt.Errorf("invalid close time %s: %v", hours.Close, err)
+		}
+		if opensAt.Before(start) {
+			opensAt = start
+		}
+		if closesAt.After(end) {
+			closesAt = end
+		}
+		if closesAt.After(opensAt) {
+			elapsed += closesAt.Sub(opensAt)
+		}
+	}
+	return int(elapsed.Minutes()), nil
+}
