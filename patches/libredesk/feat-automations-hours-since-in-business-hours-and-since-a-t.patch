+var hoursSinceFields = []string{models.ConversationHoursSinceCreated, models.ConversationHoursSinceFirstReply,
+	models.ConversationHoursSinceLastReply, models.ConversationHoursSinceResolved,
+	models.ConversationHoursSinceLastResolved, models.ConversationHoursSinceTagAdded}
+
+// SetBusinessHoursStore sets where conditions in business hours read the working time.
+func (e *Engine) SetBusinessHoursStore(store businessHoursStore) {
+	e.businessHours = store
+}
+
+// hoursSinceStart is when an hours_since_* condition starts counting, zero if that has not happened.
+func (e *Engine) hoursSinceStart(rule models.RuleDetail, conversation cmodels.Conversation) (time.Time, bool) {
+	switch rule.Field {
+	case models.ConversationHoursSinceCreated:
+		return conversation.CreatedAt, true
+	case models.ConversationHoursSinceFirstReply:
+		return conversation.FirstReplyAt.Time, true
+	case models.ConversationHoursSinceLastReply:
+		return conversation.LastReplyAt.Time, true
+	case models.ConversationHoursSinceResolved:
+		return conversation.ResolvedAt.Time, true
+	case models.ConversationHoursSinceLastResolved:
+		return conversation.LastResolvedAt.Time, true
+	case models.ConversationHoursSinceTagAdded:
+		addedAt, err := e.conversationStore.TagAddedAt(conversation.ID, strings.TrimSpace(rule.Tag))
+		if err != nil {
+			e.lo.Error("error fetching when the tag was added", "tag", rule.Tag, "conversation_uuid", conversation.UUID, "error", err)
+			return time.Time{}, false
+		}
+		return addedAt, true
+	}
+	return time.Time{}, false
+}
+
+// hoursSince is the whole hours from start to now, counting only open time when the condition asks for business hours.
+func (e *Engine) hoursSince(start time.Time, rule models.RuleDetail, conversation cmodels.Conversation) (string, bool) {
+	hours := time.Since(start).Hours()
+	if rule.BusinessHours {
+		if e.businessHours == nil {
+			return "", false
+		}
+		minutes, err := e.businessHours.ElapsedBusinessMinutes(conversation.AssignedTeamID.Int, start, time.Now())
+		if err != nil {
+			e.lo.Error("error counting business hours", "field", rule.Field, "conversation_uuid", conversation.UUID, "error", err)
+			return "", false
+		}
+		hours = float64(minutes) / 60
+	}
+	return fmt.Sprintf("%.0f", hours), true
+}
+
 func isActorField(field string) bool {
 	return field == models.ConversationAssignedUser || field == models.ConversationPreviousAssignedUser
 }
