diff --git a/internal/inbox/channel/livechat/kuraka.go b/internal/inbox/channel/livechat/kuraka.go
new file mode 100644
index 00000000..555bb789
--- /dev/null
+++ b/internal/inbox/channel/livechat/kuraka.go
@@ -0,0 +1,48 @@
+package livechat
+
+import (
+	"encoding/json"
+	"maps"
+
+	"github.com/abhinavxd/libredesk/internal/conversation/models"
+	umodels "github.com/abhinavxd/libredesk/internal/user/models"
+	"github.com/volatiletech/null/v9"
+)
+
+// MaskAgent replaces an agent's name with the brand name and drops the avatar when
+// hide_agent_names is on. Contacts and visitors are left untouched.
+func (c Config) MaskAgent(userType string, firstName, lastName *string, avatarURL *null.String) {
+	if !c.HideAgentNames || (userType != umodels.UserTypeAgent && userType != umodels.UserTypeAIAssistant) {
+		return
+	}
+	*firstName, *lastName, *avatarURL = c.BrandName, "", null.String{}
+}
+
+// MaskMessageAuthor hides agent identity in the author and historical campaign metadata.
+func (c Config) MaskMessageAuthor(author *models.MessageAuthor, meta *json.RawMessage) {
+	if !c.HideAgentNames {
+		return
+	}
+	c.MaskAgent(author.Type, &author.FirstName, &author.LastName, &author.AvatarURL)
+	if len(*meta) == 0 {
+		return
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(*meta, &fields); err == nil && fields["proactive_sender"] != nil {
+		delete(fields, "proactive_sender")
+		*meta, _ = json.Marshal(fields) // Unmarshal already validated each JSON value.
+	}
+}
+
+// maskAssignee copies and masks a full assignment update while preserving presence fields.
+func (c Config) maskAssignee(data map[string]any) map[string]any {
+	assignee, _ := data["assignee"].(map[string]any)
+	if _, hasName := assignee["first_name"]; !c.HideAgentNames || !hasName {
+		return data
+	}
+	data = maps.Clone(data)
+	assignee = maps.Clone(assignee)
+	assignee["first_name"], assignee["last_name"], assignee["avatar_url"] = c.BrandName, "", nil
+	data["assignee"] = assignee
+	return data
+}
