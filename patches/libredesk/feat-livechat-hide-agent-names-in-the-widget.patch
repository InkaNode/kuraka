index 00000000..bf966d09
--- /dev/null
+++ b/cmd/chat_kuraka.go
@@ -0,0 +1,24 @@
+package main
+
+import (
+	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/abhinavxd/libredesk/internal/inbox/channel/livechat"
+)
+
+// hideAgentNamesInConversation replaces agent names and avatars with the brand name in a
+// widget conversation when the inbox has hide_agent_names.
+func hideAgentNamesInConversation(config livechat.Config, c *cmodels.ChatConversation) {
+	if c.Assignee != nil {
+		config.MaskAgent(c.Assignee.Type, &c.Assignee.FirstName, &c.Assignee.LastName, &c.Assignee.AvatarURL)
+	}
+	a := &c.LastChatMessage.Author
+	config.MaskAgent(a.Type, &a.FirstName, &a.LastName, &a.AvatarURL)
+	hideAgentNamesInMessages(config, c.UnreadMessages)
+}
+
+// hideAgentNamesInMessages does the same for widget messages.
+func hideAgentNamesInMessages(config livechat.Config, messages []cmodels.ChatMessage) {
+	for i := range messages {
+		config.MaskMessageAuthor(&messages[i].Author, &messages[i].Meta)
+	}
+}
diff --git a/cmd/chat_kuraka_test.go b/cmd/chat_kuraka_test.go
new file mode 100644
index 00000000..c75e3f73
--- /dev/null
+++ b/cmd/chat_kuraka_test.go
@@ -0,0 +1,52 @@
+package main
+
+import (
+	"testing"
+
+	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/abhinavxd/libredesk/internal/inbox/channel/livechat"
+	umodels "github.com/abhinavxd/libredesk/internal/user/models"
+	"github.com/volatiletech/null/v9"
+)
+
+func TestHideAgentNamesInConversation(t *testing.T) {
+	newConv := func() cmodels.ChatConversation {
+		avatar := null.StringFrom("https://x/a.png")
+		c := cmodels.ChatConversation{
+			Assignee: &umodels.ChatUser{FirstName: "Ana", LastName: "Ruiz", AvatarURL: avatar, Type: umodels.UserTypeAgent, AvailabilityStatus: "away"},
+			UnreadMessages: []cmodels.ChatMessage{
+				{
+					Author: cmodels.MessageAuthor{FirstName: "Bot", AvatarURL: avatar, Type: umodels.UserTypeAIAssistant},
+					Meta:   []byte(`{"campaign_id":"123","proactive_sender":"Bot"}`),
+				},
+				{Author: cmodels.MessageAuthor{FirstName: "Visitor", AvatarURL: avatar, Type: umodels.UserTypeVisitor}},
+			},
+		}
+		c.LastChatMessage.Author = umodels.ChatUser{FirstName: "Ana", AvatarURL: avatar, Type: cmodels.SenderTypeAgent}
+		return c
+	}
+
+	c := newConv()
+	hideAgentNamesInConversation(livechat.Config{BrandName: "Acme"}, &c)
+	if c.Assignee.FirstName != "Ana" || !c.Assignee.AvatarURL.Valid {
+		t.Fatalf("names must be kept when hide_agent_names is off: %+v", c.Assignee)
+	}
+
+	c = newConv()
+	hideAgentNamesInConversation(livechat.Config{BrandName: "Acme", HideAgentNames: true}, &c)
+	if a := c.Assignee; a.FirstName != "Acme" || a.LastName != "" || a.AvatarURL.Valid || a.AvailabilityStatus != "away" {
+		t.Fatalf("assignee not masked: %+v", a)
+	}
+	if a := c.UnreadMessages[0].Author; a.FirstName != "Acme" || a.AvatarURL.Valid {
+		t.Fatalf("AI author not masked: %+v", a)
+	}
+	if a := c.UnreadMessages[1].Author; a.FirstName != "Visitor" || !a.AvatarURL.Valid {
+		t.Fatalf("visitor must be kept: %+v", a)
+	}
+	if a := c.LastChatMessage.Author; a.FirstName != "Acme" || a.AvatarURL.Valid {
+		t.Fatalf("last message author not masked: %+v", a)
+	}
+	if meta := string(c.UnreadMessages[0].Meta); meta != `{"campaign_id":"123"}` {
+		t.Fatalf("unexpected masked message metadata: %s", meta)
+	}
+}
