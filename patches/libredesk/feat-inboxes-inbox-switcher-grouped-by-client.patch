+++ b/frontend/apps/main/src/components/sidebar/KurakaInboxSwitcher.vue
@@ -0,0 +1,115 @@
+<template>
+  <div class="px-2 pb-1">
+    <Tooltip v-if="inboxes.length <= 1">
+      <TooltipTrigger as-child>
+        <div
+          tabindex="0"
+          aria-disabled="true"
+          class="flex h-10 w-full cursor-default items-center gap-2 rounded-md border border-border px-2 text-left text-sm opacity-80"
+        >
+          <Mail class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
+          <span class="min-w-0 flex-1 truncate">{{ inboxes[0]?.name ?? t('kuraka.allInboxes') }}</span>
+          <ChevronsUpDown class="size-3.5 shrink-0 opacity-30" aria-hidden="true" />
+        </div>
+      </TooltipTrigger>
+      <TooltipContent side="right" class="max-w-60">
+        <p>{{ t('kuraka.onlyInbox') }}</p>
+      </TooltipContent>
+    </Tooltip>
+
+    <DropdownMenu v-else>
+      <DropdownMenuTrigger as-child>
+        <button
+          type="button"
+          :aria-label="t('kuraka.switchInbox')"
+          class="flex h-10 w-full items-center gap-2 rounded-md border border-border px-2 text-left text-sm transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
+        >
+          <Mail class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
+          <span class="min-w-0 flex-1 truncate">{{ active?.name ?? t('kuraka.allInboxes') }}</span>
+          <span v-if="!active" class="text-xs tabular-nums text-muted-foreground">{{ inboxes.length }}</span>
+          <ChevronsUpDown class="size-3.5 shrink-0 opacity-50" aria-hidden="true" />
+        </button>
+      </DropdownMenuTrigger>
+      <DropdownMenuContent align="start" class="max-h-[70vh] w-64 overflow-y-auto">
+        <DropdownMenuRadioGroup
+          :model-value="conversationStore.activeInboxID"
+          @update:model-value="conversationStore.setActiveInbox"
+        >
+          <DropdownMenuRadioItem value="">
+            {{ t('kuraka.allInboxes') }}
+            <span class="ml-auto pl-2 text-xs tabular-nums text-muted-foreground">{{ inboxes.length }}</span>
+          </DropdownMenuRadioItem>
+          <template v-for="group in groups" :key="group.name">
+            <DropdownMenuSeparator />
+            <DropdownMenuLabel class="flex items-center text-xs font-medium text-muted-foreground">
+              <span class="truncate">{{ group.name }}</span>
+              <span class="ml-auto pl-2 tabular-nums">{{ group.inboxes.length }}</span>
+            </DropdownMenuLabel>
+            <DropdownMenuRadioItem
+              v-for="inbox in group.inboxes"
+              :key="inbox.id"
+              :value="String(inbox.id)"
+            >
+              <span class="flex min-w-0 flex-col">
+                <span class="truncate">{{ inbox.name }}</span>
+                <span v-if="inbox.email" class="truncate text-xs text-muted-foreground">{{ inbox.email }}</span>
+              </span>
+            </DropdownMenuRadioItem>
+          </template>
+        </DropdownMenuRadioGroup>
+      </DropdownMenuContent>
+    </DropdownMenu>
+  </div>
+</template>
+
+<script setup>
+// Kuraka: pick which inbox the conversation lists show, grouped by client (the
+// address domain). Inboxes are added from Kuraka, so one inbox shows a hint instead.
+import { computed, watch } from 'vue'
+import { useI18n } from 'vue-i18n'
+import { Mail, ChevronsUpDown } from 'lucide-vue-next'
+import {
+  DropdownMenu,
+  DropdownMenuContent,
+  DropdownMenuLabel,
+  DropdownMenuRadioGroup,
+  DropdownMenuRadioItem,
+  DropdownMenuSeparator,
+  DropdownMenuTrigger
+} from '@shared-ui/components/ui/dropdown-menu'
+import { Tooltip, TooltipContent, TooltipTrigger } from '@shared-ui/components/ui/tooltip'
+import { useInboxStore } from '@main/stores/inbox'
+import { useConversationStore } from '@main/stores/conversation'
+import { extractEmailAddress } from '@main/utils/email-sender'
+
+const { t } = useI18n()
+const inboxStore = useInboxStore()
+const conversationStore = useConversationStore()
+
+const inboxes = computed(() =>
+  inboxStore.inboxes
+    .filter((inbox) => inbox.enabled)
+    .map((inbox) => ({ ...inbox, email: inbox.from ? extractEmailAddress(inbox.from) : '' }))
+)
+
+const groups = computed(() => {
+  const byName = new Map()
+  for (const inbox of inboxes.value) {
+    const name = inbox.email.split('@')[1] || inbox.channel
+    if (!byName.has(name)) byName.set(name, [])
+    byName.get(name).push(inbox)
+  }
+  return [...byName].map(([name, list]) => ({ name, inboxes: list }))
+})
+
+const active = computed(() =>
+  inboxes.value.find((inbox) => String(inbox.id) === conversationStore.activeInboxID)
+)
+
+// A remembered inbox that was removed or disabled falls back to all inboxes.
+watch(
+  () => inboxStore.inboxes.length && conversationStore.activeInboxID && !active.value,
+  (stale) => stale && conversationStore.setActiveInbox(''),
+  { immediate: true }
+)
+</script>
