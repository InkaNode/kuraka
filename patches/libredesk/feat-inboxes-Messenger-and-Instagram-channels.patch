diff --git a/cmd/meta_webhook.go b/cmd/meta_webhook.go
new file mode 100644
index 00000000..a90b7263
--- /dev/null
+++ b/cmd/meta_webhook.go
@@ -0,0 +1,273 @@
+package main
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/abhinavxd/libredesk/internal/attachment"
+	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/abhinavxd/libredesk/internal/envelope"
+	metaChannel "github.com/abhinavxd/libredesk/internal/inbox/channel/meta"
+	imodels "github.com/abhinavxd/libredesk/internal/inbox/models"
+	umodels "github.com/abhinavxd/libredesk/internal/user/models"
+	"github.com/abhinavxd/libredesk/internal/whatsapp"
+	"github.com/valyala/fasthttp"
+	"github.com/volatiletech/null/v9"
+	"github.com/zerodha/fastglue"
+)
+
+// Meta waits about 20 seconds for a webhook answer before it retries.
+const metaWebhookTimeout = 15 * time.Second
+
+type metaWebhookPayload struct {
+	Object string `json:"object"`
+	Entry  []struct {
+		ID        string           `json:"id"`
+		Messaging []metaMessaging `json:"messaging"`
+	} `json:"entry"`
+}
+
+type metaMessaging struct {
+	Sender    struct{ ID string } `json:"sender"`
+	Timestamp int64               `json:"timestamp"`
+	Message   *struct {
+		MID         string `json:"mid"`
+		Text        string `json:"text"`
+		IsEcho      bool   `json:"is_echo"`
+		IsDeleted   bool   `json:"is_deleted"`
+		Attachments []struct {
+			Type    string `json:"type"`
+			Payload struct {
+				URL string `json:"url"`
+			} `json:"payload"`
+		} `json:"attachments"`
+	} `json:"message"`
+}
+
+func handleMetaWebhookVerify(r *fastglue.Request) error {
+	app := r.Context.(*App)
+	inboxID, err := inboxIDFromPath(r)
+	if err != nil {
+		return r.SendErrorEnvelope(fasthttp.StatusBadRequest, "invalid inbox id", nil, envelope.InputError)
+	}
+	args := r.RequestCtx.QueryArgs()
+	if string(args.Peek("hub.mode")) != "subscribe" {
+		return r.SendErrorEnvelope(fasthttp.StatusBadRequest, "invalid hub.mode", nil, envelope.InputError)
+	}
+	_, cfg, err := metaInbox(app, inboxID)
+	if err != nil {
+		return r.SendErrorEnvelope(fasthttp.StatusNotFound, "inbox not found", nil, envelope.NotFoundError)
+	}
+	if cfg.WebhookVerifyToken == "" || string(args.Peek("hub.verify_token")) != cfg.WebhookVerifyToken {
+		return r.SendErrorEnvelope(fasthttp.StatusForbidden, "verify token mismatch", nil, envelope.PermissionError)
+	}
+	r.RequestCtx.SetStatusCode(fasthttp.StatusOK)
+	r.RequestCtx.SetBody(args.Peek("hub.challenge"))
+	return nil
+}
+
+func handleMetaWebhookEvent(r *fastglue.Request) error {
+	app := r.Context.(*App)
+	inboxID, err := inboxIDFromPath(r)
+	if err != nil {
+		return r.SendErrorEnvelope(fasthttp.StatusBadRequest, "invalid inbox id", nil, envelope.InputError)
+	}
+	rec, cfg, err := metaInbox(app, inboxID)
+	if err != nil {
+		return r.SendErrorEnvelope(fasthttp.StatusNotFound, "inbox not found", nil, envelope.NotFoundError)
+	}
+	body := r.RequestCtx.PostBody()
+	if cfg.AppSecret == "" || !whatsapp.VerifySignature(body, string(r.RequestCtx.Request.Header.Peek("X-Hub-Signature-256")), cfg.AppSecret) {
+		app.lo.Warn("meta webhook signature verification failed", "inbox_id", inboxID)
+		return r.SendErrorEnvelope(fasthttp.StatusForbidden, "invalid signature", nil, envelope.PermissionError)
+	}
+	var payload metaWebhookPayload
+	if err := json.Unmarshal(body, &payload); err != nil {
+		return r.SendErrorEnvelope(fasthttp.StatusBadRequest, "invalid payload", nil, envelope.InputError)
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), metaWebhookTimeout)
+	defer cancel()
+	// frugal: processed inline; WhatsApp's durable queue is the upgrade if Meta's retries are not enough.
+	var errs []error
+	for _, entry := range payload.Entry {
+		// One Meta app posts every Page's events to one URL, so the Page ID picks the inbox.
+		target := resolveMetaInbox(app, rec, entry.ID)
+		if target.ID == 0 {
+			app.lo.Warn("dropping meta event: no enabled inbox for page", "url_inbox_id", inboxID, "page_id", entry.ID)
+			continue
+		}
+		for _, ev := range entry.Messaging {
+			if ev.Message == nil || ev.Message.IsEcho || ev.Message.IsDeleted || ev.Message.MID == "" || ev.Sender.ID == "" {
+				continue
+			}
+			if err := ingestMetaMessage(ctx, app, target, ev); err != nil {
+				app.lo.Error("error ingesting meta message", "inbox_id", target.ID, "mid", ev.Message.MID, "error", err)
+				errs = append(errs, err)
+			}
+		}
+	}
+	if len(errs) > 0 {
+		return r.SendErrorEnvelope(fasthttp.StatusInternalServerError, "retry", nil, envelope.GeneralError)
+	}
+	return r.SendEnvelope(map[string]string{"status": "ok"})
+}
+
+func ingestMetaMessage(ctx context.Context, app *App, rec imodels.Inbox, ev metaMessaging) error {
+	if exists, err := app.conversation.MessageExists(ev.Message.MID); err != nil {
+		return err
+	} else if exists {
+		return nil
+	}
+	inb, err := app.inbox.Get(rec.ID)
+	if err != nil {
+		return fmt.Errorf("getting inbox: %w", err)
+	}
+	ch, ok := inb.(*metaChannel.Meta)
+	if !ok {
+		return fmt.Errorf("inbox %d is not a meta inbox", rec.ID)
+	}
+
+	contactID, err := app.user.UpsertContactByChannelIdentity(rec.Channel, ev.Sender.ID, &umodels.User{Type: umodels.UserTypeContact, FirstName: whatsAppDefaultContactName})
+	if err != nil {
+		return fmt.Errorf("resolving contact: %w", err)
+	}
+	contact, err := app.user.GetContactOrVisitor(contactID, "")
+	if err != nil {
+		return fmt.Errorf("checking contact: %w", err)
+	}
+	if !contact.Enabled {
+		return nil
+	}
+	if contact.FirstName == whatsAppDefaultContactName && contact.LastName == "" {
+		if name := ch.Profile(ctx, ev.Sender.ID); name != "" {
+			first, last := splitName(name)
+			if err := app.user.UpdateContactNameIfDefault(contactID, first, last, whatsAppDefaultContactName); err != nil {
+				app.lo.Error("error updating meta contact name", "user_id", contactID, "error", err)
+			}
+		}
+	}
+
+	maxBytes := int64(app.consts.Load().(*constants).MaxFileUploadSizeMB) * 1024 * 1024
+	var atts attachment.Attachments
+	var placeholders []string
+	for _, a := range ev.Message.Attachments {
+		if a.Payload.URL == "" {
+			placeholders = append(placeholders, "["+a.Type+"]")
+			continue
+		}
+		data, ctype, err := ch.Download(ctx, a.Payload.URL, maxBytes)
+		if err != nil || len(data) == 0 {
+			app.lo.Warn("meta attachment not downloaded, inserting placeholder", "mid", ev.Message.MID, "error", err)
+			placeholders = append(placeholders, "["+a.Type+"]")
+			continue
+		}
+		atts = append(atts, attachment.Attachment{
+			Name:        defaultMediaFilename(a.Type, ctype),
+			ContentType: ctype,
+			Content:     data,
+			Size:        len(data),
+			Disposition: attachment.DispositionAttachment,
+		})
+	}
+	content := strings.TrimSpace(strings.Join(append([]string{ev.Message.Text}, placeholders...), " "))
+	if content == "" && len(atts) == 0 {
+		content = "[message]"
+	}
+
+	defer lockWhatsAppConversation(contactID, rec.ID)()
+	isNew := false
+	convID, convUUID, err := app.conversation.GetLatestOpenConversationForContact(contactID, rec.ID)
+	if errors.Is(err, sql.ErrNoRows) && rec.ReopenWindowHours > 0 {
+		convID, convUUID, err = app.conversation.GetReopenableConversationForContact(contactID, rec.ID, rec.ReopenWindowHours)
+	}
+	if errors.Is(err, sql.ErrNoRows) {
+		convID, convUUID, err = app.conversation.CreateConversation(contactID, rec.ID, content, time.Now(), "", false, nil, nil, 0, 0)
+		if err != nil {
+			return fmt.Errorf("creating conversation: %w", err)
+		}
+		isNew = true
+	} else if err != nil {
+		return fmt.Errorf("looking up conversation: %w", err)
+	}
+
+	at := time.Now()
+	if ev.Timestamp > 0 {
+		at = time.UnixMilli(ev.Timestamp)
+	}
+	msg := cmodels.Message{
+		Channel:          rec.Channel,
+		ConversationID:   convID,
+		ConversationUUID: convUUID,
+		SenderID:         contactID,
+		SenderType:       cmodels.SenderTypeContact,
+		Type:             cmodels.MessageIncoming,
+		Status:           cmodels.MessageStatusReceived,
+		InboxID:          rec.ID,
+		Content:          content,
+		ContentType:      cmodels.ContentTypeText,
+		SourceID:         null.StringFrom(ev.Message.MID),
+		Attachments:      atts,
+	}
+	if _, err := app.conversation.ProcessIncomingWhatsAppMessage(msg, isNew, at); err != nil {
+		return fmt.Errorf("processing meta message: %w", err)
+	}
+	return nil
+}
+
+// resolveMetaInbox returns the enabled inbox of the URL's channel whose Page ID matches, or the URL inbox when it matches. A zero ID means none.
+func resolveMetaInbox(app *App, urlRec imodels.Inbox, pageID string) imodels.Inbox {
+	if urlRec.Enabled && metaPageID(urlRec) == pageID {
+		return urlRec
+	}
+	inboxes, err := app.inbox.GetAll()
+	if err != nil {
+		app.lo.Error("error listing inboxes for meta routing", "error", err)
+		return imodels.Inbox{}
+	}
+	for _, rec := range inboxes {
+		if rec.Channel == urlRec.Channel && rec.Enabled && metaPageID(rec) == pageID {
+			return rec
+		}
+	}
+	return imodels.Inbox{}
+}
+
+func metaPageID(rec imodels.Inbox) string {
+	var cfg metaChannel.Config
+	_ = json.Unmarshal(rec.Config, &cfg)
+	return cfg.PageID
+}
+
+func metaInbox(app *App, inboxID int) (imodels.Inbox, metaChannel.Config, error) {
+	rec, err := app.inbox.GetDBRecord(inboxID)
+	if err != nil {
+		return rec, metaChannel.Config{}, err
+	}
+	if !metaChannel.IsMeta(rec.Channel) {
+		return rec, metaChannel.Config{}, fmt.Errorf("inbox %d is not a meta inbox", inboxID)
+	}
+	var cfg metaChannel.Config
+	if err := json.Unmarshal(rec.Config, &cfg); err != nil {
+		return rec, cfg, fmt.Errorf("decoding meta inbox config: %w", err)
+	}
+	return rec, cfg, nil
+}
+
+// subscribeMetaPage connects the inbox's Page to the app webhook after a save. Best-effort: the inbox works once the Page is subscribed by hand too.
+func subscribeMetaPage(app *App, inboxID int) {
+	inb, err := app.inbox.Get(inboxID)
+	if err != nil {
+		return
+	}
+	if ch, ok := inb.(*metaChannel.Meta); ok {
+		if err := ch.Subscribe(); err != nil {
+			app.lo.Warn("error subscribing facebook page to webhook", "inbox_id", inboxID, "error", err)
+		}
+	}
+}
