+package meta
+
+import (
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/abhinavxd/libredesk/internal/whatsapp"
+	"github.com/zerodha/logf"
+)
+
+func TestSplitText(t *testing.T) {
+	if got := splitText("hola", 10); len(got) != 1 || got[0] != "hola" {
+		t.Fatalf("short text: %q", got)
+	}
+	got := splitText("uno dos tres cuatro", 8)
+	for _, p := range got {
+		if len([]rune(p)) > 8 {
+			t.Fatalf("part too long: %q", p)
+		}
+	}
+	if strings.Join(got, " ") != "uno dos tres cuatro" {
+		t.Fatalf("lost words: %q", got)
+	}
+	if got := splitText(strings.Repeat("ñ", 25), 10); len(got) != 3 {
+		t.Fatalf("no spaces: %q", got)
+	}
+}
+
+func TestSendText(t *testing.T) {
+	var body map[string]any
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/"+whatsapp.DefaultAPIVersion+"/me/messages" || r.Header.Get("Authorization") != "Bearer tok" {
+			t.Errorf("unexpected request %s %s", r.URL.Path, r.Header.Get("Authorization"))
+		}
+		raw, _ := io.ReadAll(r.Body)
+		_ = json.Unmarshal(raw, &body)
+		_, _ = w.Write([]byte(`{"recipient_id":"123","message_id":"m_1"}`))
+	}))
+	defer srv.Close()
+	BaseURL = srv.URL
+
+	lo := logf.New(logf.Opts{})
+	m, err := New(1, "Page", ChannelMessenger, Config{PageID: "p", AccessToken: "tok"}, &lo)
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = m.Send(models.OutboundMessage{Content: "<p>Hola</p>", ContentType: models.ContentTypeHTML, Meta: json.RawMessage(`{"meta":{"recipient_id":"123"}}`)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if body["recipient"].(map[string]any)["id"] != "123" || !strings.Contains(body["message"].(map[string]any)["text"].(string), "Hola") {
+		t.Fatalf("unexpected body: %v", body)
+	}
+	if err := m.Send(models.OutboundMessage{Content: "x"}); err == nil {
+		t.Fatal("expected an error without a recipient")
+	}
+}
