+package conversation
+
+import (
+	"github.com/abhinavxd/libredesk/internal/envelope"
+	"github.com/abhinavxd/libredesk/internal/inbox"
+	imodels "github.com/abhinavxd/libredesk/internal/inbox/models"
+)
+
+// prepareMetaOutbound writes the Messenger or Instagram recipient into metaMap. Meta only lets a Page answer people who wrote first.
+func (m *Manager) prepareMetaOutbound(inboxRecord imodels.Inbox, conversationUUID string, hasAttachments bool, metaMap map[string]any) error {
+	// frugal: Instagram replies are text only; Messenger uploads files with the message.
+	if hasAttachments && inboxRecord.Channel == inbox.ChannelInstagram {
+		return envelope.NewError(envelope.InputError, m.i18n.T("kuraka.instagramNoFiles"), nil)
+	}
+	var conv struct {
+		InboxID   int `db:"inbox_id"`
+		ContactID int `db:"contact_id"`
+	}
+	if err := m.q.GetConversationInboxContact.Get(&conv, conversationUUID); err != nil {
+		m.lo.Error("error fetching conversation inbox and contact", "conversation_uuid", conversationUUID, "error", err)
+		return envelope.NewError(envelope.GeneralError, m.i18n.T("globals.messages.somethingWentWrong"), nil)
+	}
+	if conv.InboxID != inboxRecord.ID {
+		return envelope.NewError(envelope.InputError, m.i18n.T("globals.messages.somethingWentWrong"), nil)
+	}
+	id, err := m.userStore.GetChannelIdentity(conv.ContactID, inboxRecord.Channel)
+	if err != nil {
+		return err
+	}
+	if id == "" {
+		return envelope.NewError(envelope.InputError, m.i18n.T("kuraka.metaNoRecipient"), nil)
+	}
+	metaMap["meta"] = map[string]string{"recipient_id": id}
+	return nil
+}
diff --git a/internal/inbox/channel/meta/meta.go b/internal/inbox/channel/meta/meta.go
new file mode 100644
index 00000000..7753d499
--- /dev/null
+++ b/internal/inbox/channel/meta/meta.go
@@ -0,0 +1,322 @@
+// Package meta implements Facebook Messenger and Instagram Direct inboxes through a Facebook Page.
+package meta
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"net/textproto"
+	"strings"
+	"time"
+
+	"github.com/abhinavxd/libredesk/internal/attachment"
+	"github.com/abhinavxd/libredesk/internal/conversation/models"
+	"github.com/abhinavxd/libredesk/internal/inbox"
+	"github.com/abhinavxd/libredesk/internal/stringutil"
+	"github.com/abhinavxd/libredesk/internal/whatsapp"
+	"github.com/zerodha/logf"
+)
+
+const (
+	ChannelMessenger = inbox.ChannelMessenger
+	ChannelInstagram = inbox.ChannelInstagram
+
+	callTimeout       = 30 * time.Second
+	uploadTimeout     = 5 * time.Minute
+
+	// Meta rejects longer texts: 2000 characters on Messenger, 1000 on Instagram.
+	maxMessengerText = 2000
+	maxInstagramText = 1000
+)
+
+// BaseURL is the Graph API root. Tests point it at a stand-in server.
+var BaseURL = "https://graph.facebook.com"
+
+// IsMeta reports whether a channel is Messenger or Instagram.
+func IsMeta(channel string) bool {
+	return channel == ChannelMessenger || channel == ChannelInstagram
+}
+
+// Config is the per-inbox configuration, with tokens already decrypted. PageID is the Facebook Page, or the Instagram account linked to it.
+type Config struct {
+	PageID             string `json:"page_id"`
+	AccessToken        string `json:"access_token"`
+	AppSecret          string `json:"app_secret"`
+	WebhookVerifyToken string `json:"webhook_verify_token"`
+	APIVersion         string `json:"api_version"`
+}
+
+func (c Config) version() string {
+	if c.APIVersion != "" {
+		return c.APIVersion
+	}
+	return whatsapp.DefaultAPIVersion
+}
+
+// SendMeta is what message.meta carries under "meta" for an outbound message.
+type SendMeta struct {
+	RecipientID string `json:"recipient_id"`
+}
+
+type Meta struct {
+	id      int
+	name    string
+	channel string
+	config  Config
+	lo      *logf.Logger
+	http    *http.Client
+}
+
+func New(id int, name, channel string, cfg Config, lo *logf.Logger) (*Meta, error) {
+	if !IsMeta(channel) {
+		return nil, fmt.Errorf("unknown meta channel %q", channel)
+	}
+	if cfg.PageID == "" || cfg.AccessToken == "" {
+		return nil, fmt.Errorf("page_id and access_token are required")
+	}
+	return &Meta{id: id, name: name, channel: channel, config: cfg, lo: lo, http: &http.Client{}}, nil
+}
+
+func (m *Meta) Identifier() int          { return m.id }
+func (m *Meta) Config() Config           { return m.config }
+func (m *Meta) Channel() string          { return m.channel }
+func (m *Meta) Name() string             { return m.name }
+func (m *Meta) FromAddress() string      { return "" }
+func (m *Meta) ReplyToAddress() string   { return "" }
+func (m *Meta) FromNameTemplate() string { return "" }
+func (m *Meta) Close() error             { return nil }
+
+// Receive is a no-op. Inbound messages arrive via the webhook handler.
+func (m *Meta) Receive(ctx context.Context) error { return nil }
+
+func (m *Meta) Send(message models.OutboundMessage) error {
+	var env struct {
+		Meta SendMeta `json:"meta"`
+	}
+	if len(message.Meta) > 0 {
+		if err := json.Unmarshal(message.Meta, &env); err != nil {
+			return fmt.Errorf("parsing meta send meta: %w", err)
+		}
+	}
+	to := env.Meta.RecipientID
+	if to == "" {
+		return fmt.Errorf("missing recipient on outbound message")
+	}
+
+	text := strings.TrimSpace(TextBody(message))
+	if text == "" && len(message.Attachments) == 0 {
+		return fmt.Errorf("outbound message has no content")
+	}
+	limit := maxMessengerText
+	if m.channel == ChannelInstagram {
+		limit = maxInstagramText
+	}
+	for _, part := range splitText(text, limit) {
+		if err := m.post(to, map[string]any{"text": part}); err != nil {
+			return err
+		}
+	}
+	for _, att := range message.Attachments {
+		if err := m.sendAttachment(to, att); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (m *Meta) post(to string, msg map[string]any) error {
+	body, err := json.Marshal(map[string]any{
+		"recipient":      map[string]string{"id": to},
+		"messaging_type": "RESPONSE",
+		"message":        msg,
+	})
+	if err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), callTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, m.messagesURL(), bytes.NewReader(body))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	return m.do(req, nil)
+}
+
+// sendAttachment uploads the file with the message, so Meta never needs to reach Libredesk.
+func (m *Meta) sendAttachment(to string, att attachment.Attachment) error {
+	var buf bytes.Buffer
+	w := multipart.NewWriter(&buf)
+	recipient, _ := json.Marshal(map[string]string{"id": to})
+	msg, _ := json.Marshal(map[string]any{"attachment": map[string]any{"type": AttachmentType(att.ContentType), "payload": map[string]bool{"is_reusable": false}}})
+	_ = w.WriteField("recipient", string(recipient))
+	_ = w.WriteField("messaging_type", "RESPONSE")
+	_ = w.WriteField("message", string(msg))
+	h := make(textproto.MIMEHeader)
+	h.Set("Content-Disposition", fmt.Sprintf(`form-data; name="filedata"; filename=%q`, att.Name))
+	h.Set("Content-Type", att.ContentType)
+	part, err := w.CreatePart(h)
+	if err != nil {
+		return err
+	}
+	if _, err := part.Write(att.Content); err != nil {
+		return err
+	}
+	if err := w.Close(); err != nil {
+		return err
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), uploadTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, m.messagesURL(), &buf)
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", w.FormDataContentType())
+	if err := m.do(req, nil); err != nil {
+		return fmt.Errorf("sending %s: %w", att.Name, err)
+	}
+	return nil
+}
+
+// Subscribe connects the Facebook Page to the app's webhook so its messages reach Libredesk. Instagram is subscribed from the app dashboard.
+func (m *Meta) Subscribe() error {
+	if m.channel != ChannelMessenger {
+		return nil
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), callTimeout)
+	defer cancel()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, fmt.Sprintf("%s/%s/%s/subscribed_apps", BaseURL, m.config.version(), m.config.PageID), strings.NewReader("subscribed_fields=messages"))
+	if err != nil {
+		return err
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+	return m.do(req, nil)
+}
+
+// Profile returns the sender's display name, or "" when Meta does not share it.
+func (m *Meta) Profile(ctx context.Context, userID string) string {
+	fields := "first_name,last_name"
+	if m.channel == ChannelInstagram {
+		fields = "name,username"
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, fmt.Sprintf("%s/%s/%s?fields=%s", BaseURL, m.config.version(), userID, fields), nil)
+	if err != nil {
+		return ""
+	}
+	var p struct {
+		FirstName string `json:"first_name"`
+		LastName  string `json:"last_name"`
+		Name      string `json:"name"`
+		Username  string `json:"username"`
+	}
+	if err := m.do(req, &p); err != nil {
+		m.lo.Warn("error fetching meta profile", "inbox_id", m.id, "error", err)
+		return ""
+	}
+	if n := strings.TrimSpace(p.FirstName + " " + p.LastName); n != "" {
+		return n
+	}
+	if p.Name != "" {
+		return p.Name
+	}
+	return p.Username
+}
+
+// Download fetches an inbound attachment from Meta's CDN, up to maxBytes.
+func (m *Meta) Download(ctx context.Context, url string, maxBytes int64) ([]byte, string, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, url, nil)
+	if err != nil {
+		return nil, "", err
+	}
+	resp, err := m.http.Do(req)
+	if err != nil {
+		return nil, "", err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return nil, "", fmt.Errorf("downloading attachment: status %d", resp.StatusCode)
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, maxBytes+1))
+	if err != nil {
+		return nil, "", err
+	}
+	if int64(len(body)) > maxBytes {
+		return nil, "", fmt.Errorf("attachment exceeds %d bytes", maxBytes)
+	}
+	return body, resp.Header.Get("Content-Type"), nil
+}
+
+func (m *Meta) messagesURL() string {
+	return fmt.Sprintf("%s/%s/me/messages", BaseURL, m.config.version())
+}
+
+func (m *Meta) do(req *http.Request, out any) error {
+	req.Header.Set("Authorization", "Bearer "+m.config.AccessToken)
+	resp, err := m.http.Do(req)
+	if err != nil {
+		return err
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if resp.StatusCode >= 300 {
+		var e struct {
+			Error struct {
+				Message string `json:"message"`
+			} `json:"error"`
+		}
+		if json.Unmarshal(body, &e) == nil && e.Error.Message != "" {
+			return fmt.Errorf("meta: %s", e.Error.Message)
+		}
+		return fmt.Errorf("meta: status %d", resp.StatusCode)
+	}
+	if out != nil {
+		return json.Unmarshal(body, out)
+	}
+	return nil
+}
+
+// AttachmentType maps a MIME type to Meta's attachment types.
+func AttachmentType(contentType string) string {
+	switch {
+	case strings.HasPrefix(contentType, "image/"):
+		return "image"
+	case strings.HasPrefix(contentType, "video/"):
+		return "video"
+	case strings.HasPrefix(contentType, "audio/"):
+		return "audio"
+	}
+	return "file"
+}
+
+// TextBody returns the reply as plain text. Raw HTML must never reach Meta.
+func TextBody(m models.OutboundMessage) string {
+	if m.ContentType == models.ContentTypeHTML && m.Content != "" {
+		return stringutil.HTML2Text(m.Content)
+	}
+	if m.TextContent != "" {
+		return m.TextContent
+	}
+	return m.Content
+}
+
+// splitText cuts text into parts of at most limit characters, preferring line breaks and spaces.
+func splitText(text string, limit int) []string {
+	var parts []string
+	r := []rune(text)
+	for len(r) > limit {
+		cut := limit
+		if i := strings.LastIndexAny(string(r[:limit]), "\n "); i > 0 {
+			cut = len([]rune(string(r[:limit])[:i]))
+		}
+		parts = append(parts, strings.TrimSpace(string(r[:cut])))
+		r = []rune(strings.TrimLeft(string(r[cut:]), "\n "))
+	}
+	if s := strings.TrimSpace(string(r)); s != "" {
+		parts = append(parts, s)
+	}
+	return parts
+}
