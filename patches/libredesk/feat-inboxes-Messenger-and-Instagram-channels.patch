+        <SwitchField
+          :title="$t('admin.inbox.promptTagsOnReply')"
+          :description="$t('admin.inbox.promptTagsOnReply.description')"
+          :checked="componentField.modelValue"
+          @update:checked="handleChange"
+        />
+      </FormItem>
+    </FormField>
+
+    <div class="max-w-xl">
+      <FormField v-slot="{ componentField }" name="reopen_window_hours">
+        <FormItem>
+          <FormLabel>{{ $t('admin.inbox.whatsapp.reopenWindow') }}</FormLabel>
+          <FormControl>
+            <Input type="number" min="0" placeholder="48" v-bind="componentField" />
+          </FormControl>
+          <FormDescription>
+            {{ $t('admin.inbox.whatsapp.reopenWindow.description') }}
+          </FormDescription>
+          <FormMessage />
+        </FormItem>
+      </FormField>
+    </div>
+
+    <div class="box p-4 space-y-4">
+      <h3 class="ui-heading">{{ $t('admin.inbox.whatsapp.metaCredentials') }}</h3>
+      <div class="max-w-xl">
+        <FormField v-slot="{ componentField }" name="config.page_id">
+          <FormItem>
+            <FormLabel>
+              {{ channel === 'instagram' ? $t('kuraka.metaInstagramId') : $t('kuraka.metaPageId') }}
+            </FormLabel>
+            <FormControl>
+              <Input type="text" v-bind="componentField" />
+            </FormControl>
+            <FormDescription>
+              {{
+                channel === 'instagram'
+                  ? $t('kuraka.metaInstagramIdHelp')
+                  : $t('kuraka.metaPageIdHelp')
+              }}
+            </FormDescription>
+            <FormMessage />
+          </FormItem>
+        </FormField>
+      </div>
+
+      <FormGrid>
+        <FormField v-slot="{ componentField }" name="config.access_token">
+          <FormItem>
+            <FormLabel>{{ $t('globals.terms.accessToken') }}</FormLabel>
+            <FormControl>
+              <Input type="password" placeholder="••••••••" v-bind="componentField" />
+            </FormControl>
+            <FormDescription>
