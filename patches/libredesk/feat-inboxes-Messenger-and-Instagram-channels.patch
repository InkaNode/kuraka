+        <span>{{ $t('kuraka.metaWebhookHelp') }}</span>
+      </p>
+
+      <div class="max-w-xl">
+        <FormField v-slot="{ componentField }" name="config.webhook_verify_token">
+          <FormItem>
+            <FormLabel>{{ $t('globals.terms.webhookVerifyToken') }}</FormLabel>
+            <FormControl>
+              <Input type="text" v-bind="componentField" />
