@@ -0,0 +1,85 @@
+package autoassigner
+
+import (
+	"testing"
+	"time"
+
+	"github.com/abhinavxd/libredesk/internal/conversation/models"
+	tmodels "github.com/abhinavxd/libredesk/internal/team/models"
+	umodels "github.com/abhinavxd/libredesk/internal/user/models"
+	"github.com/jmoiron/sqlx/types"
+	"github.com/volatiletech/null/v9"
+	"github.com/zerodha/logf"
+)
+
+type fakeStore struct {
+	teams   []tmodels.Team
+	convs   []models.Conversation
+	claimed map[string]int
+}
+
+func (f *fakeStore) GetUnassignedConversations() ([]models.Conversation, error) {
+	var out []models.Conversation
+	for _, c := range f.convs {
+		if _, ok := f.claimed[c.UUID]; !ok {
+			out = append(out, c)
+		}
+	}
+	return out, nil
+}
+func (f *fakeStore) ClaimUnassignedConversation(uuid string, userID, _ int, _ umodels.User) error {
+	f.claimed[uuid] = userID
+	return nil
+}
+func (f *fakeStore) ActiveUserConversationsCount(int) (int, error) { return 0, nil }
+func (f *fakeStore) GetAll() ([]tmodels.Team, error)                { return f.teams, nil }
+func (f *fakeStore) GetMembers(teamID int) ([]tmodels.TeamMember, error) {
+	return []tmodels.TeamMember{{ID: teamID * 10}}, nil
+}
+func (f *fakeStore) Get(key string) (types.JSONText, error) {
+	return map[string]types.JSONText{"app.auto_assign_instant": types.JSONText("true"), "app.auto_assign_interval": types.JSONText("300")}[key], nil
+}
+
+func TestRunDue(t *testing.T) {
+	rr := AssignmentTypeRoundRobin
+	f := &fakeStore{
+		teams: []tmodels.Team{
+			{ID: 1, ConversationAssignmentType: rr},
+			{ID: 2, ConversationAssignmentType: rr, AutoAssignInstant: null.BoolFrom(false)},
+			{ID: 3, ConversationAssignmentType: rr, AutoAssignInterval: null.IntFrom(10)},
+			{ID: 4, ConversationAssignmentType: "Manual"},
+		},
+		claimed: map[string]int{},
+	}
+	for i := 1; i <= 4; i++ {
+		f.convs = append(f.convs, models.Conversation{UUID: string(rune('0' + i)), AssignedTeamID: null.IntFrom(i)})
+	}
+	lo := logf.New(logf.Opts{})
+	e, _ := New(f, f, f, umodels.User{}, &lo)
+
+	notified := map[int]bool{1: true, 2: true, 4: true}
+	e.runDue(func(tm tmodels.Team, instant bool, _ time.Duration) bool { return instant && notified[tm.ID] })
+	if len(f.claimed) != 1 || f.claimed["1"] != 10 {
+		t.Fatalf("instant: want only team 1 assigned, got %v", f.claimed)
+	}
+
+	tick := func(now time.Time) {
+		e.runDue(func(tm tmodels.Team, _ bool, interval time.Duration) bool { return e.isDue(now, tm.ID, interval) })
+	}
+	f.convs = append(f.convs, models.Conversation{UUID: "5", AssignedTeamID: null.IntFrom(1)})
+	tick(time.Now())
+	if f.claimed["2"] != 20 || f.claimed["3"] != 30 || f.claimed["5"] != 0 || f.claimed["4"] != 0 {
+		t.Fatalf("first tick: want teams 2 and 3 assigned, team 1 not due yet, got %v", f.claimed)
+	}
+
+	f.convs = append(f.convs, models.Conversation{UUID: "6", AssignedTeamID: null.IntFrom(3)}, models.Conversation{UUID: "7", AssignedTeamID: null.IntFrom(2)})
+	tick(time.Now().Add(20 * time.Second))
+	if f.claimed["6"] != 30 || f.claimed["7"] != 0 {
+		t.Fatalf("second tick: want only team 3 assigned, got %v", f.claimed)
+	}
+
+	tick(time.Now().Add(5 * time.Minute))
+	if f.claimed["5"] != 10 || f.claimed["7"] != 20 {
+		t.Fatalf("after 5 minutes: want teams 1 and 2 assigned, got %v", f.claimed)
+	}
+}
