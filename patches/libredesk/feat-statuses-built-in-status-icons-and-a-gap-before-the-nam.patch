   "sla.new": "New SLA policy",
   "sla.overdueBy": "Overdue by",
   "sla.selectMetric": "Select SLA metric",
+  "status.builtinIcons": "Built-in icons",
   "status.deletionConfirmation": "This action cannot be undone. This will permanently delete this status.",
   "status.deniedPermission": "Permission denied",
   "status.disabledFileUpload": "File Upload is disabled",
diff --git a/i18n/es-ES.json b/i18n/es-ES.json
index 475e8cef..e14e2af3 100644
--- a/i18n/es-ES.json
+++ b/i18n/es-ES.json
@@ -914,6 +914,7 @@
   "sla.new": "Nueva política SLA",
   "sla.overdueBy": "Vencido por",
   "sla.selectMetric": "Seleccionar métrica SLA",
+  "status.builtinIcons": "Íconos incluidos",
   "status.deletionConfirmation": "Esta acción no se puede deshacer. Se eliminará permanentemente este estado.",
   "status.deniedPermission": "Permiso denegado",
   "status.disabledFileUpload": "La subida de archivos está desactivada",
diff --git a/internal/kuraka/migrate.go b/internal/kuraka/migrate.go
index 2ad954dc..c224dbe6 100644
--- a/internal/kuraka/migrate.go
+++ b/internal/kuraka/migrate.go
@@ -17,10 +17,17 @@ func Migrate(db *sqlx.DB) error {
     ADD COLUMN IF NOT EXISTS display_name TEXT NOT NULL DEFAULT '' CHECK (length(display_name) <= 50),
     ADD COLUMN IF NOT EXISTS icon TEXT NOT NULL DEFAULT '' CHECK (length(icon) <= 2048);
    UPDATE conversation_statuses SET icon = CASE name
-    WHEN 'Open' THEN '🟢' WHEN 'Snoozed' THEN '💤' WHEN 'Resolved' THEN '✅' WHEN 'Closed' THEN '🔒' END
+    WHEN 'Open' THEN 'kuraka:open' WHEN 'Snoozed' THEN 'kuraka:snoozed' WHEN 'Resolved' THEN 'kuraka:resolved' WHEN 'Closed' THEN 'kuraka:closed' END
    WHERE name IN ('Open', 'Snoozed', 'Resolved', 'Closed');
   END IF;
  END $$`)
+	if err != nil {
+		return err
+	}
+	// Default statuses still on the old emoji move to Kuraka's built-in icons.
+	_, err = tx.Exec(`UPDATE conversation_statuses SET icon = CASE icon
+    WHEN '🟢' THEN 'kuraka:open' WHEN '💤' THEN 'kuraka:snoozed' WHEN '✅' THEN 'kuraka:resolved' WHEN '🔒' THEN 'kuraka:closed' END
+   WHERE (name, icon) IN (('Open', '🟢'), ('Snoozed', '💤'), ('Resolved', '✅'), ('Closed', '🔒'))`)
 	if err != nil {
 		return err
 	}
