+import "github.com/jmoiron/sqlx"
+
+// AgentsOnline counts enabled human agents that are online, only members of teamID when it is not 0.
+func AgentsOnline(db *sqlx.DB, teamID int) (int, error) {
+	var n int
+	err := db.Get(&n, `SELECT COUNT(*) FROM users u
+  WHERE u.type = 'agent' AND u.enabled AND u.deleted_at IS NULL AND u.availability_status = 'online'
+  AND ($1 = 0 OR EXISTS (SELECT 1 FROM team_members tm WHERE tm.user_id = u.id AND tm.team_id = $1))`, teamID)
+	return n, err
+}
