+// StatusWaiting is the status of a live chat that nobody could take when it started.
+const StatusWaiting = "Waiting"
+
+// openIfWaiting moves a Waiting conversation to Open once a human agent is assigned to it or replies in it.
+// A zero actor means the agent itself.
+func (c *Manager) openIfWaiting(uuid string, agentID int, actor umodels.User) {
+	agent, err := c.userStore.GetAgentCachedOrLoad(agentID)
+	if err != nil || agent.Type != umodels.UserTypeAgent || !agent.Enabled || agent.Email.String == umodels.SystemUserEmail {
+		return
+	}
+	conversation, err := c.GetConversation(0, uuid, "")
+	if err != nil || conversation.Status.String != StatusWaiting {
+		return
+	}
+	if actor.ID == 0 {
+		actor = agent
+	}
+	if err := c.UpdateConversationStatus(uuid, 0, models.StatusOpen, "", actor); err != nil {
