+func TestDecideAvailability(t *testing.T) {
+	lima, err := time.LoadLocation("America/Lima")
+	if err != nil {
+		t.Fatal(err)
+	}
+	hours := &bhmodels.BusinessHours{Hours: []byte(`{"Monday":{"open":"09:00","close":"17:00"}}`), Holidays: []byte(`[]`)}
+	holiday := &bhmodels.BusinessHours{Hours: hours.Hours, Holidays: []byte(`[{"name":"x","date":"2026-11-23"}]`)}
+	monday := func(clock string) time.Time {
+		at, _ := time.ParseInLocation("2006-01-02 15:04", "2026-11-23 "+clock, lima)
+		return at
+	}
+	tests := []struct {
+		name   string
+		now    time.Time
+		hours  *bhmodels.BusinessHours
+		loc    *time.Location
+		online int
+		want   chatAvailability
+	}{
+		{"no hours, nobody online", monday("03:00"), nil, lima, 0, chatAvailability{false, true, false}},
+		{"no hours, agent online", monday("03:00"), nil, lima, 2, chatAvailability{true, true, true}},
+		{"always open", monday("03:00"), &bhmodels.BusinessHours{IsAlwaysOpen: true}, lima, 1, chatAvailability{true, true, true}},
+		{"in hours", monday("10:00"), hours, lima, 1, chatAvailability{true, true, true}},
+		{"in hours, nobody online", monday("10:00"), hours, lima, 0, chatAvailability{false, true, false}},
+		{"after hours", monday("17:00"), hours, lima, 1, chatAvailability{false, false, true}},
+		{"holiday", monday("10:00"), holiday, lima, 1, chatAvailability{false, false, true}},
+		// 15:00 in Lima is 20:00 UTC: the timezone decides.
+		{"timezone in hours", monday("15:00"), hours, lima, 1, chatAvailability{true, true, true}},
+		{"timezone out of hours", monday("15:00"), hours, time.UTC, 1, chatAvailability{false, false, true}},
+	}
+	for _, tc := range tests {
+		got, err := decideAvailability(tc.now, tc.hours, tc.loc, tc.online)
+		if err != nil {
+			t.Fatalf("%s: %v", tc.name, err)
+		}
+		if got != tc.want {
+			t.Errorf("%s: got %+v, want %+v", tc.name, got, tc.want)
+		}
+	}
+}
+
+func TestValidateLiveChatKuraka(t *testing.T) {
+	app := newValidatorTestApp(t)
+	items := func(n, labelLen, answerLen int) []livechat.MenuItem {
+		out := make([]livechat.MenuItem, n)
+		for i := range out {
+			out[i] = livechat.MenuItem{Label: strings.Repeat("é", labelLen), Answer: strings.Repeat("é", answerLen)}
+		}
+		return out
+	}
+	tests := []struct {
+		name    string
+		config  livechat.Config
+		wantErr bool
+	}{
+		{name: "nothing set", config: livechat.Config{}},
+		{name: "negative team", config: livechat.Config{TeamID: -1}, wantErr: true},
+		{name: "menu at limits", config: livechat.Config{Menu: &livechat.MenuConfig{Enabled: true, Items: items(8, 60, 1000), AgentButtonText: strings.Repeat("é", 60)}}},
+		{name: "too many items", config: livechat.Config{Menu: &livechat.MenuConfig{Items: items(9, 1, 1)}}, wantErr: true},
+		{name: "label too long", config: livechat.Config{Menu: &livechat.MenuConfig{Items: items(1, 61, 1)}}, wantErr: true},
+		{name: "empty label", config: livechat.Config{Menu: &livechat.MenuConfig{Items: items(1, 0, 1)}}, wantErr: true},
+		{name: "answer too long", config: livechat.Config{Menu: &livechat.MenuConfig{Items: items(1, 1, 1001)}}, wantErr: true},
+		{name: "agent button too long", config: livechat.Config{Menu: &livechat.MenuConfig{AgentButtonText: strings.Repeat("a", 61)}}, wantErr: true},
+		{name: "wait without email", config: livechat.Config{Offline: &livechat.OfflineConfig{Mode: "wait"}}},
+		{name: "wait bad email", config: livechat.Config{Offline: &livechat.OfflineConfig{Mode: "wait", Email: "nope"}}, wantErr: true},
+		{name: "both with email", config: livechat.Config{Offline: &livechat.OfflineConfig{Mode: "both", Email: "help@example.com"}}},
+		{name: "email without email", config: livechat.Config{Offline: &livechat.OfflineConfig{Mode: "email"}}, wantErr: true},
+		{name: "email with name", config: livechat.Config{Offline: &livechat.OfflineConfig{Mode: "email", Email: "Help <help@example.com>"}}, wantErr: true},
+		{name: "unknown mode", config: livechat.Config{Offline: &livechat.OfflineConfig{Mode: "later", Email: "help@example.com"}}, wantErr: true},
+	}
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			assertValidation(t, validateLiveChatKuraka(app, tc.config), tc.wantErr)
+		})
+	}
+}
