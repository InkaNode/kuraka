+// chatAvailability tells the widget whether a visitor asking for an agent can get one now.
+type chatAvailability struct {
+	Available       bool `json:"available"`
+	InBusinessHours bool `json:"in_business_hours"`
+	AgentsOnline    bool `json:"agents_online"`
+}
+
+// decideAvailability is available when now is in the business hours (nil = always) and an agent is online.
+func decideAvailability(now time.Time, hours *bhmodels.BusinessHours, loc *time.Location, agentsOnline int) (chatAvailability, error) {
+	inHours := true
+	if hours != nil {
+		var err error
+		if inHours, err = withinBusinessHours(*hours, now, loc); err != nil {
+			return chatAvailability{}, err
+		}
+	}
+	return chatAvailability{
+		Available:       inHours && agentsOnline > 0,
+		InBusinessHours: inHours,
+		AgentsOnline:    agentsOnline > 0,
+	}, nil
+}
+
+// liveChatAvailability uses the team's business hours and timezone when it has them, else the general ones.
+func liveChatAvailability(app *App, teamID int) (chatAvailability, error) {
+	var hoursID int
+	timezone := ""
+	if teamID > 0 {
+		if team, err := app.team.Get(teamID); err == nil {
+			hoursID, timezone = team.BusinessHoursID.Int, team.Timezone
+		}
+	}
+	if hoursID == 0 {
+		var id string
+		if b, err := app.setting.Get("app.business_hours_id"); err == nil && json.Unmarshal(b, &id) == nil {
+			hoursID, _ = strconv.Atoi(id)
+		}
+	}
+	if timezone == "" {
+		timezone = app.setting.GetAppTimezone()
+	}
+	loc, err := time.LoadLocation(timezone)
+	if err != nil {
+		return chatAvailability{}, err
+	}
+	var hours *bhmodels.BusinessHours
+	if hoursID > 0 {
+		h, err := app.businessHours.Get(hoursID)
+		if err != nil {
+			return chatAvailability{}, err
+		}
+		hours = &h
+	}
+	online, err := kuraka.AgentsOnline(app.db, teamID)
+	if err != nil {
+		return chatAvailability{}, err
+	}
+	return decideAvailability(time.Now(), hours, loc, online)
+}
+
+// handleChatAvailability returns whether an agent can take a chat now, without counts or names.
+func handleChatAvailability(r *fastglue.Request) error {
+	app := r.Context.(*App)
+	config, err := getWidgetConfig(r)
+	if err != nil {
+		return sendErrorEnvelope(r, envelope.NewError(envelope.GeneralError, app.i18n.T("globals.messages.somethingWentWrong"), nil))
+	}
+	availability, err := liveChatAvailability(app, config.TeamID)
+	if err != nil {
+		app.lo.Error("error checking live chat availability", "error", err)
+		return sendErrorEnvelope(r, envelope.NewError(envelope.GeneralError, app.i18n.T("globals.messages.somethingWentWrong"), nil))
+	}
+	return r.SendEnvelope(availability)
+}
+
+// chatInitWaits reports whether a new chat starts as Waiting; with nobody available and offline mode email it returns a 403 error.
+func chatInitWaits(app *App, config livechat.Config) (bool, error) {
+	if config.Offline == nil {
+		return false, nil
+	}
+	availability, err := liveChatAvailability(app, config.TeamID)
+	if err != nil {
+		app.lo.Error("error checking live chat availability", "error", err)
+		return false, envelope.NewError(envelope.GeneralError, app.i18n.T("globals.messages.somethingWentWrong"), nil)
+	}
+	if availability.Available {
+		return false, nil
+	}
+	if config.Offline.Mode == livechat.OfflineEmail {
+		return false, envelope.NewError(envelope.PermissionError, app.i18n.T("widget.noAgentsEmail"), nil)
+	}
+	return true, nil
+}
+
+// validateLiveChatKuraka checks the team_id, menu and offline live chat config keys.
+func validateLiveChatKuraka(app *App, config livechat.Config) error {
+	if field := config.InvalidKurakaField(); field != "" {
+		return envelope.NewError(envelope.InputError, app.i18n.Ts("kuraka.liveChatInvalidField", "name", field), nil)
+	}
+	if config.TeamID > 0 {
+		// Not found is a 400 with the team not found message.
+		if _, err := app.team.Get(config.TeamID); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// startLiveChat marks a new live chat Waiting when nobody can take it and assigns it to the inbox team,
+// through the manager so activities, team auto-assignment and automations run.
+func startLiveChat(app *App, conversationUUID string, teamID int, waiting bool) {
+	if !waiting && teamID == 0 {
+		return
+	}
+	system, err := app.user.GetSystemUser()
+	if err != nil {
+		app.lo.Error("error fetching system user", "error", err)
+		return
+	}
+	if waiting {
+		if err := app.conversation.UpdateConversationStatus(conversationUUID, 0, conversation.StatusWaiting, "", system); err != nil {
+			app.lo.Error("error setting live chat as waiting", "conversation_uuid", conversationUUID, "error", err)
+		}
+	}
+	if teamID > 0 {
+		if err := app.conversation.UpdateConversationTeamAssignee(conversationUUID, teamID, system); err != nil {
+			app.lo.Error("error assigning live chat to team", "conversation_uuid", conversationUUID, "team_id", teamID, "error", err)
+		}
+	}
+}
