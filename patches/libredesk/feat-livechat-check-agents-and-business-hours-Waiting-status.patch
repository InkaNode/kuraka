+
+// Offline modes: what the visitor can do when nobody is available.
+const (
+	OfflineWait  = "wait"
+	OfflineBoth  = "both"
+	OfflineEmail = "email"
+)
+
+// MenuConfig is the menu shown before any conversation.
+type MenuConfig struct {
+	Enabled         bool       `json:"enabled"`
+	Items           []MenuItem `json:"items"`
+	AgentButtonText string     `json:"agent_button_text"`
+}
+
+// MenuItem is a menu button and the answer shown when it is clicked.
+type MenuItem struct {
+	Label  string `json:"label"`
+	Answer string `json:"answer"`
+}
+
+// OfflineConfig sets what happens when the visitor asks for an agent and nobody is available.
+type OfflineConfig struct {
+	Mode  string `json:"mode"`
+	Email string `json:"email"`
+}
+
+// InvalidKurakaField returns the first invalid menu or offline config key, or "".
+func (c Config) InvalidKurakaField() string {
+	if c.TeamID < 0 {
+		return "team_id"
+	}
+	if m := c.Menu; m != nil {
+		if len(m.Items) > 8 {
+			return "menu.items"
+		}
+		for _, item := range m.Items {
+			if strings.TrimSpace(item.Label) == "" || utf8.RuneCountInString(item.Label) > 60 {
+				return "menu.items.label"
+			}
+			if strings.TrimSpace(item.Answer) == "" || utf8.RuneCountInString(item.Answer) > 1000 {
+				return "menu.items.answer"
+			}
+		}
+		if utf8.RuneCountInString(m.AgentButtonText) > 60 {
+			return "menu.agent_button_text"
+		}
+	}
+	if o := c.Offline; o != nil {
+		switch o.Mode {
+		case OfflineWait:
+			if o.Email != "" && !stringutil.ValidEmail(o.Email) {
+				return "offline.email"
+			}
+		case OfflineBoth, OfflineEmail:
+			if !stringutil.ValidEmail(o.Email) {
+				return "offline.email"
+			}
+		default:
+			return "offline.mode"
+		}
+	}
+	return ""
+}
