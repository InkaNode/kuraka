diff --git a/frontend/apps/widget/src/composables/useChatMenu.js b/frontend/apps/widget/src/composables/useChatMenu.js
new file mode 100644
index 00000000..3fd69ff5
--- /dev/null
+++ b/frontend/apps/widget/src/composables/useChatMenu.js
@@ -0,0 +1,68 @@
+import { reactive, watch, effectScope } from 'vue'
+import api from '@widget/api/index.js'
+import { useWidgetStore } from '@widget/store/widget.js'
+
+const OFFLINE_MODES = ['wait', 'both', 'email']
+
+// Module state so the menu history survives leaving and reopening the chat view.
+// offline: '' (no notice), 'wait', 'both' or 'email' after an unavailable check.
+export const menuState = reactive({ history: [], agentChosen: false, offline: '', checking: false })
+
+let nextId = 0
+let resetScope = null
+
+// What the agent button leads to: 'continue' or the offline mode to show.
+// A missing availability (request error) fails open.
+export function resolveOffline (offline, availability) {
+  if (!OFFLINE_MODES.includes(offline?.mode)) return 'continue'
+  if (availability?.available !== false) return 'continue'
+  return offline.mode
+}
+
+export function selectMenuItem (item) {
+  menuState.history.push(
+    { id: ++nextId, from: 'visitor', text: String(item.label ?? '') },
+    { id: ++nextId, from: 'bot', text: String(item.answer ?? '') }
+  )
+}
+
+export async function chooseAgent (offline) {
+  if (menuState.checking) return
+  let result = 'continue'
+  if (OFFLINE_MODES.includes(offline?.mode)) {
+    menuState.checking = true
+    let availability = null
+    try {
+      const inboxID = new URLSearchParams(window.location.search).get('inbox_id')
+      availability = (await api.getAvailability(inboxID)).data?.data
+    } catch {
+      availability = null
+    } finally {
+      menuState.checking = false
+    }
+    result = resolveOffline(offline, availability)
+  }
+  if (result !== 'continue') menuState.offline = result
+  if (result === 'continue' || result === 'wait') menuState.agentChosen = true
+}
+
+export function waitForAgent () {
+  menuState.agentChosen = true
+}
+
+export function resetMenu () {
+  menuState.history = []
+  menuState.agentChosen = false
+  menuState.offline = ''
+  menuState.checking = false
+}
+
+// Clears the menu once the widget is closed.
+export function useChatMenu () {
+  if (!resetScope) {
+    const widgetStore = useWidgetStore()
+    resetScope = effectScope(true)
+    resetScope.run(() => watch(() => widgetStore.isOpen, (open) => { if (!open) resetMenu() }))
+  }
+  return { menuState, selectMenuItem, chooseAgent, waitForAgent, resetMenu }
+}
diff --git a/frontend/apps/widget/src/composables/useChatMenu.test.js b/frontend/apps/widget/src/composables/useChatMenu.test.js
new file mode 100644
index 00000000..d9d246b6
--- /dev/null
+++ b/frontend/apps/widget/src/composables/useChatMenu.test.js
@@ -0,0 +1,77 @@
+// @vitest-environment jsdom
+import { beforeEach, describe, expect, test, vi } from 'vitest'
+import api from '@widget/api/index.js'
+import { menuState, resolveOffline, selectMenuItem, chooseAgent, waitForAgent, resetMenu } from './useChatMenu.js'
+
+vi.mock('@widget/api/index.js', () => ({ default: { getAvailability: vi.fn() } }))
+vi.mock('@widget/store/widget.js', () => ({ useWidgetStore: () => ({ isOpen: true }) }))
+
+const unavailable = { data: { data: { available: false, in_business_hours: false, agents_online: false } } }
+
+beforeEach(() => {
+  resetMenu()
+  vi.clearAllMocks()
+  window.history.replaceState({}, '', '/?inbox_id=abc')
+})
+
+describe('resolveOffline', () => {
+  test('continues without offline config or when available', () => {
+    expect(resolveOffline(undefined, { available: false })).toBe('continue')
+    expect(resolveOffline({ mode: '' }, { available: false })).toBe('continue')
+    expect(resolveOffline({ mode: 'both' }, { available: true })).toBe('continue')
+  })
+  test('fails open on missing availability', () => {
+    expect(resolveOffline({ mode: 'email' }, null)).toBe('continue')
+  })
+  test('returns the mode when unavailable', () => {
+    for (const mode of ['wait', 'both', 'email']) expect(resolveOffline({ mode }, { available: false })).toBe(mode)
+  })
+})
+
+describe('menu state', () => {
+  test('item adds visitor label and answer as text bubbles', () => {
+    selectMenuItem({ label: 'Hours', answer: '<b>9-5</b>' })
+    expect(menuState.history.map(e => [e.from, e.text])).toEqual([['visitor', 'Hours'], ['bot', '<b>9-5</b>']])
+    expect(api.getAvailability).not.toHaveBeenCalled()
+  })
+
+  test('no offline config skips the availability check', async () => {
+    await chooseAgent(undefined)
+    expect(api.getAvailability).not.toHaveBeenCalled()
+    expect(menuState.agentChosen).toBe(true)
+  })
+
+  test('request error fails open', async () => {
+    api.getAvailability.mockRejectedValueOnce(new Error('down'))
+    await chooseAgent({ mode: 'email', email: 'a@b.c' })
+    expect(api.getAvailability).toHaveBeenCalledWith('abc')
+    expect(menuState).toMatchObject({ agentChosen: true, offline: '', checking: false })
+  })
+
+  test('wait shows notice and continues', async () => {
+    api.getAvailability.mockResolvedValueOnce(unavailable)
+    await chooseAgent({ mode: 'wait' })
+    expect(menuState).toMatchObject({ agentChosen: true, offline: 'wait' })
+  })
+
+  test('both waits for a choice, then continues', async () => {
+    api.getAvailability.mockResolvedValueOnce(unavailable)
+    await chooseAgent({ mode: 'both', email: 'a@b.c' })
+    expect(menuState).toMatchObject({ agentChosen: false, offline: 'both' })
+    waitForAgent()
+    expect(menuState.agentChosen).toBe(true)
+  })
+
+  test('email never continues', async () => {
+    api.getAvailability.mockResolvedValueOnce(unavailable)
+    await chooseAgent({ mode: 'email', email: 'a@b.c' })
+    expect(menuState).toMatchObject({ agentChosen: false, offline: 'email' })
+  })
+
+  test('reset clears history and choice', async () => {
+    selectMenuItem({ label: 'a', answer: 'b' })
+    await chooseAgent(undefined)
+    resetMenu()
+    expect(menuState).toMatchObject({ history: [], agentChosen: false, offline: '' })
+  })
+})
