--- /dev/null
+++ b/internal/automation/actor_test.go
@@ -0,0 +1,54 @@
+package automation
+
+import (
+	"testing"
+
+	"github.com/abhinavxd/libredesk/internal/automation/models"
+	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
+	umodels "github.com/abhinavxd/libredesk/internal/user/models"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/mock"
+	"github.com/volatiletech/null/v9"
+)
+
+func TestActorRules(t *testing.T) {
+	assignActor := []models.RuleAction{{Type: models.ActionAssignUser, Value: []string{models.ValueActor}}, {Type: models.ActionAddTags, Value: []string{"x"}}}
+	unassigned := []models.RuleGroup{{LogicalOp: models.OperatorAnd, Rules: []models.RuleDetail{{Field: models.ConversationAssignedUser, FieldType: models.FieldTypeConversationField, Operator: models.RuleOperatorNotSet}}}}
+	assignedToActor := []models.RuleGroup{{LogicalOp: models.OperatorAnd, Rules: []models.RuleDetail{{Field: models.ConversationAssignedUser, FieldType: models.FieldTypeConversationField, Operator: models.RuleOperatorEquals, Value: models.ValueActor}}}}
+	tag := []models.RuleAction{{Type: models.ActionAddTags, Value: []string{"x"}}}
+
+	for _, tc := range []struct {
+		name     string
+		groups   []models.RuleGroup
+		actions  []models.RuleAction
+		assigned int
+		actor    umodels.User
+		want     []models.RuleAction
+	}{
+		{"agent reply assigns the agent", unassigned, assignActor, 0, umodels.User{ID: 7}, []models.RuleAction{{Type: models.ActionAssignUser, Value: []string{"7"}}, tag[0]}},
+		{"contact is never assigned", unassigned, assignActor, 0, umodels.User{ID: 5}, tag},
+		{"system is never assigned", unassigned, assignActor, 0, umodels.User{ID: testSystemUserID}, tag},
+		{"AI assistant is never assigned", unassigned, assignActor, 0, umodels.User{ID: 8}, tag},
+		{"assigned to the actor matches", assignedToActor, tag, 7, umodels.User{ID: 7}, tag},
+		{"assigned to someone else does not match", assignedToActor, tag, 3, umodels.User{ID: 7}, nil},
+		{"no actor never matches", assignedToActor, tag, 0, umodels.User{}, nil},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			store := &mockConversationStore{nonAgents: map[int]bool{8: true}}
+			store.On("ApplyAction", mock.Anything, mock.Anything, mock.Anything).Return(nil)
+			engine := createTestEngine(store)
+			engine.systemUserID = testSystemUserID
+			conv := createTestConversation(func(c *cmodels.Conversation) {
+				c.ContactID = 5
+				if tc.assigned > 0 {
+					c.AssignedUserID = null.IntFrom(tc.assigned)
+				}
+			})
+			rule := createTestRule(tc.groups, tc.actions, models.OperatorAnd)
+			engine.evalConversationRules([]models.Rule{rule}, conv, nil, tc.actor)
+			assert.Equal(t, tc.want, store.appliedActions)
+			assert.Equal(t, models.ValueActor, assignActor[0].Value[0], "cached rule must not change")
+			assert.Equal(t, models.ValueActor, assignedToActor[0].Rules[0].Value, "cached rule must not change")
+		})
+	}
+}
