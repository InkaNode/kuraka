+++ b/internal/automation/kuraka.go
@@ -4,14 +4,74 @@ import (
 	"encoding/json"
 	"fmt"
 	"slices"
+	"strconv"
 	"strings"
 
 	"github.com/abhinavxd/libredesk/internal/automation/models"
 	cmodels "github.com/abhinavxd/libredesk/internal/conversation/models"
 	"github.com/abhinavxd/libredesk/internal/envelope"
 	"github.com/abhinavxd/libredesk/internal/kuraka"
+	umodels "github.com/abhinavxd/libredesk/internal/user/models"
 )
 
+func isActorField(field string) bool {
+	return field == models.ConversationAssignedUser || field == models.ConversationPreviousAssignedUser
+}
+
+func isActorAction(action models.RuleAction) bool {
+	return action.Type == models.ActionAssignUser && len(action.Value) > 0 && action.Value[0] == models.ValueActor
+}
+
+// usesActor reports whether a rule refers to the agent whose action fired the event.
+func usesActor(rule models.Rule) bool {
+	for _, group := range rule.Groups {
+		for _, condition := range group.Rules {
+			if isActorField(condition.Field) && condition.Value == models.ValueActor {
+				return true
+			}
+		}
+	}
+	return slices.ContainsFunc(rule.Actions, isActorAction)
+}
+
+// agentActorID is the human agent who fired the event, or 0 for the system, the contact, an AI assistant or no one.
+func (e *Engine) agentActorID(conversation cmodels.Conversation, actor umodels.User) int {
+	if actor.ID <= 0 || actor.ID == e.systemUserID || actor.ID == conversation.ContactID || !e.conversationStore.IsHumanAgent(actor.ID) {
+		return 0
+	}
+	return actor.ID
+}
+
+// withActor copies the rule with the actor in place of "actor". Without an agent, conditions on it
+// never match and assigning to it is dropped.
+func withActor(rule models.Rule, actorID int) models.Rule {
+	value := "-1"
+	if actorID > 0 {
+		value = strconv.Itoa(actorID)
+	}
+	groups := make([]models.RuleGroup, len(rule.Groups))
+	for i, group := range rule.Groups {
+		groups[i] = models.RuleGroup{LogicalOp: group.LogicalOp, Rules: slices.Clone(group.Rules)}
+		for j, condition := range groups[i].Rules {
+			if isActorField(condition.Field) && condition.Value == models.ValueActor {
+				groups[i].Rules[j].Value = value
+			}
+		}
+	}
+	actions := make([]models.RuleAction, 0, len(rule.Actions))
+	for _, action := range rule.Actions {
+		if isActorAction(action) {
+			if actorID <= 0 {
+				continue
+			}
+			action.Value = []string{value}
+		}
+		actions = append(actions, action)
+	}
+	rule.Groups, rule.Actions = groups, actions
+	return rule
+}
+
 // evaluateTagRule compares whole tag names, ignoring case. equals means exactly
 // the requested tags, no more and no fewer.
 func evaluateTagRule(tags []string, rule models.RuleDetail) bool {
@@ -140,6 +200,9 @@ func validateRuleFields(record models.RuleRecord) error {
 				default:
 					return invalid(fmt.Sprintf("invalid automation field type %q", condition.FieldType))
 				}
+				if isActorField(condition.Field) && condition.Value == models.ValueActor && record.Type != models.RuleTypeConversationUpdate {
+					return invalid("the agent who did the action requires a conversation_update rule")
+				}
 				if !slices.Contains([]string{models.RuleOperatorContains, models.RuleOperatorNotContains,
 					models.RuleOperatorEquals, models.RuleOperatorNotEqual, models.RuleOperatorSet,
 					models.RuleOperatorNotSet, models.RuleOperatorGreaterThan, models.RuleOperatorLessThan,
@@ -148,6 +211,9 @@ func validateRuleFields(record models.RuleRecord) error {
 				}
 			}
 		}
+		if slices.ContainsFunc(rule.Actions, isActorAction) && record.Type != models.RuleTypeConversationUpdate {
+			return invalid("the agent who did the action requires a conversation_update rule")
+		}
 	}
 	return nil
 }
