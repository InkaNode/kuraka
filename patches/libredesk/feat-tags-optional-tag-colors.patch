@@ -60,14 +60,28 @@ const tagStore = useTagStore()
 
 const placeholderText = computed(() => props.placeholder || t('placeholders.selectTags'))
 
+// Cached per color so chips keep the same component across renders.
+const colorDots = {}
+const withColorDot = (item) => ({
+  ...item,
+  icon: item.color
+    ? (colorDots[item.color] ||= () =>
+        h('span', { class: 'flex items-center justify-center' }, [
+          h('span', { class: 'size-2.5 rounded-full', style: { backgroundColor: item.color } })
+        ]))
+    : undefined
+})
+
 const items = computed(() =>
   props.valueField === 'id'
     ? tagStore.tagOptions
-    : tagStore.tagNames.map((name) => ({ label: name, value: name }))
+    : tagStore.tags.map((tag) => withColorDot({ label: tag.name, value: tag.name, color: tag.color }))
 )
 
-const searchTags = (query) =>
-  props.valueField === 'id' ? tagStore.searchTagOptions(query) : tagStore.searchTagNames(query)
+const searchTags = async (query) =>
+  props.valueField === 'id'
+    ? tagStore.searchTagOptions(query)
+    : (await tagStore.searchTagNames(query)).map(withColorDot)
 
 onMounted(tagStore.fetchTags)
 
