diff --git a/internal/kuraka/migrate.go b/internal/kuraka/migrate.go
index c224dbe6..cf88843e 100644
--- a/internal/kuraka/migrate.go
+++ b/internal/kuraka/migrate.go
@@ -28,6 +28,15 @@ func Migrate(db *sqlx.DB) error {
 	_, err = tx.Exec(`UPDATE conversation_statuses SET icon = CASE icon
     WHEN '🟢' THEN 'kuraka:open' WHEN '💤' THEN 'kuraka:snoozed' WHEN '✅' THEN 'kuraka:resolved' WHEN '🔒' THEN 'kuraka:closed' END
    WHERE (name, icon) IN (('Open', '🟢'), ('Snoozed', '💤'), ('Resolved', '✅'), ('Closed', '🔒'))`)
+	if err != nil {
+		return err
+	}
+	_, err = tx.Exec(`DO $$ BEGIN
+  IF NOT EXISTS (SELECT 1 FROM information_schema.columns
+   WHERE table_schema = current_schema() AND table_name = 'tags' AND column_name = 'color') THEN
+   ALTER TABLE tags ADD COLUMN IF NOT EXISTS color TEXT NOT NULL DEFAULT '' CHECK (color = '' OR color ~ '^#[0-9a-f]{6}$');
+  END IF;
+ END $$`)
 	if err != nil {
 		return err
 	}
