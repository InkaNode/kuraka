+// keepAssigneeOnTeamChange reports whether the assigned user stays when a conversation moves from team prevTeamID to teamID, per app.keep_assignee_on_team_change and the teams' keep_assignee.
+func (c *Manager) keepAssigneeOnTeamChange(prevTeamID, teamID int) bool {
+	b, err := c.settingsStore.Get("app.keep_assignee_on_team_change")
+	if err != nil {
+		c.lo.Error("error fetching keep assignee on team change setting", "error", err)
+		return false
+	}
+	var mode string
+	if err := json.Unmarshal(b, &mode); err != nil {
+		c.lo.Error("error parsing keep assignee on team change setting", "error", err)
+		return false
+	}
+	if mode != "new_team" && mode != "both_teams" {
+		return false
+	}
+	team, err := c.teamStore.Get(teamID)
+	if err != nil {
+		c.lo.Error("error fetching team for keep assignee", "team_id", teamID, "error", err)
+		return false
+	}
+	if !team.KeepAssignee || mode == "new_team" || prevTeamID == 0 {
+		return team.KeepAssignee
+	}
+	prevTeam, err := c.teamStore.Get(prevTeamID)
+	if err != nil {
+		c.lo.Error("error fetching previous team for keep assignee", "team_id", prevTeamID, "error", err)
+		return false
+	}
+	return prevTeam.KeepAssignee
+}
