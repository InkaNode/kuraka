diff --git a/frontend/apps/main/src/utils/teamInboxOrder.js b/frontend/apps/main/src/utils/teamInboxOrder.js
new file mode 100644
index 00000000..feaaac85
--- /dev/null
+++ b/frontend/apps/main/src/utils/teamInboxOrder.js
@@ -0,0 +1,31 @@
+// Kuraka: how an agent orders their team inboxes. position is the agent's own order; 0 (never moved, e.g. a team joined later) goes last.
+const byName = (a, b) => a.name.localeCompare(b.name, undefined, { sensitivity: 'base' })
+const slot = (team) => team.position || Infinity
+const byPosition = (a, b) => slot(a) - slot(b) || byName(a, b)
+const byWeight = (a, b) => (b.weight || 0) - (a.weight || 0) || byPosition(a, b)
+
+export const sortTeamInboxes = (teams, sort) =>
+  [...teams].sort(sort === 'name' ? byName : sort === 'weight' ? byWeight : byPosition)
+
+// By weight, teams with the same weight form one section and only move inside it.
+export const teamInboxSections = (teams, sort) => {
+  const sorted = sortTeamInboxes(teams, sort)
+  if (sort !== 'weight') return [{ key: 'all', teams: sorted }]
+  const sections = []
+  for (const team of sorted) {
+    const weight = team.weight || 0
+    if (sections.at(-1)?.weight !== weight) sections.push({ key: `w${weight}`, weight, teams: [] })
+    sections.at(-1).teams.push(team)
+  }
+  return sections
+}
+
+// New manual order after a section is rearranged: the section's teams swap among the slots they held.
+export const reorderTeamInboxes = (manualOrder, sectionTeams, newTeams) => {
+  const order = [...manualOrder]
+  const slots = sectionTeams.map((team) => order.indexOf(team.id)).sort((a, b) => a - b)
+  newTeams.forEach((team, i) => {
+    order[slots[i]] = team.id
+  })
+  return order
+}
