+const SORT_OPTIONS = [
+  { value: 'manual', label: 'kuraka.sortManual', icon: GripVertical },
+  { value: 'name', label: 'kuraka.sortName', icon: ArrowDownAZ },
+  { value: 'weight', label: 'kuraka.sortWeight', icon: Weight }
+]
+
+const open = defineModel('open', { type: Boolean, default: true })
+const route = useRoute()
+const { t } = useI18n()
+const reducedMotion = usePreferredReducedMotion()
+const userStore = useUserStore()
+const { navigateToTeamInbox } = useInboxNavigation()
+
+const sort = computed(() => userStore.user.team_inbox_sort || 'manual')
+const group = computed(() => !!userStore.user.team_inbox_group)
+const canMove = computed(() => sort.value !== 'name')
+const showHeaders = computed(() => sort.value === 'weight' && group.value)
+const sections = computed(() => teamInboxSections(userStore.teams, sort.value))
+const manualOrder = computed(() => sortTeamInboxes(userStore.teams, 'manual').map((team) => team.id))
+
+const save = (change) =>
+  userStore.saveTeamInboxOrder({ sort: sort.value, group: group.value, order: manualOrder.value, ...change })
+
+const reorder = (section, teams) =>
+  save({ order: reorderTeamInboxes(manualOrder.value, section.teams, teams) })
