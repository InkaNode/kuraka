@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest'
+import { reorderTeamInboxes, sortTeamInboxes, teamInboxSections } from './teamInboxOrder'
+
+const teams = [
+  { id: 1, name: 'Ventas', weight: 5, position: 2 },
+  { id: 2, name: 'general', weight: 0, position: 0 },
+  { id: 3, name: 'Reclamos', weight: 5, position: 1 },
+  { id: 4, name: 'Meta', position: 0 }
+]
+const ids = (list) => list.map((team) => team.id)
+
+describe('team inbox order', () => {
+  it('sorts by name, by own position and by weight', () => {
+    expect(ids(sortTeamInboxes(teams, 'name'))).toEqual([2, 4, 3, 1])
+    expect(ids(sortTeamInboxes(teams, 'manual'))).toEqual([3, 1, 2, 4])
+    expect(ids(sortTeamInboxes(teams, 'weight'))).toEqual([3, 1, 2, 4])
+  })
+
+  it('groups the same weight, missing weight counts as 0', () => {
+    const sections = teamInboxSections(teams, 'weight')
+    expect(sections.map((s) => [s.weight, ids(s.teams)])).toEqual([[5, [3, 1]], [0, [2, 4]]])
+    expect(teamInboxSections(teams, 'name')).toHaveLength(1)
+  })
+
+  it('moves teams only among the slots their section held', () => {
+    const section = [teams[2], teams[0]]
+    expect(reorderTeamInboxes([2, 3, 4, 1], section, [teams[0], teams[2]])).toEqual([2, 1, 4, 3])
+  })
