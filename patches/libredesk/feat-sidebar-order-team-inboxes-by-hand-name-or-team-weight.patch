+// teamInboxOrderRequest is how an agent sorts their team inboxes; Order lists team IDs top to bottom.
+type teamInboxOrderRequest struct {
+	Sort  string `json:"sort"`
+	Group bool   `json:"group"`
+	Order []int  `json:"order"`
+}
+
+// handleUpdateTeamInboxOrder saves the current agent's team inbox order.
+func handleUpdateTeamInboxOrder(r *fastglue.Request) error {
+	var (
+		app   = r.Context.(*App)
+		auser = r.RequestCtx.UserValue("user").(amodels.User)
+		req   teamInboxOrderRequest
+	)
+	if err := r.Decode(&req, "json"); err != nil {
+		return r.SendErrorEnvelope(fasthttp.StatusBadRequest, app.i18n.T("errors.parsingRequest"), nil, envelope.InputError)
+	}
+	if !slices.Contains([]string{"manual", "name", "weight"}, req.Sort) || len(req.Order) > 1000 {
+		return r.SendErrorEnvelope(fasthttp.StatusBadRequest, app.i18n.T("errors.parsingRequest"), nil, envelope.InputError)
+	}
+	if err := app.user.UpdateTeamInboxOrder(auser.ID, req.Sort, req.Group, req.Order); err != nil {
+		return sendErrorEnvelope(r, err)
+	}
+	app.user.InvalidateAgentCache(auser.ID)
+	u, err := app.user.GetAgentCachedOrLoad(auser.ID)
+	if err != nil {
+		return sendErrorEnvelope(r, err)
+	}
+	return r.SendEnvelope(u)
+}
