diff --git a/cmd/kuraka.go b/cmd/kuraka.go
index 4ffe227d..71aef450 100644
--- a/cmd/kuraka.go
+++ b/cmd/kuraka.go
@@ -2,7 +2,9 @@ package main
 
 import (
 	"encoding/json"
+	"slices"
 	"strconv"
+	"strings"
 	"time"
 
 	bhmodels "github.com/abhinavxd/libredesk/internal/business_hours/models"
@@ -131,6 +133,30 @@ func chatInitWaits(app *App, config livechat.Config) (bool, error) {
 	return true, nil
 }
 
+// checkWaitingEmail asks for an email before a Waiting chat starts, so the team can answer later.
+// Only when the pre-chat form shows the email field; a returning contact's saved email counts.
+func checkWaitingEmail(app *App, config livechat.Config, formData map[string]any, contactID int) error {
+	asksEmail := config.PreChatForm.Enabled && slices.ContainsFunc(config.PreChatForm.Fields, func(f livechat.PreChatFormField) bool {
+		return f.Enabled && f.Key == "email"
+	})
+	if !asksEmail {
+		return nil
+	}
+	if email, _ := formData["email"].(string); strings.TrimSpace(email) != "" {
+		return nil
+	}
+	if contactID > 0 {
+		contact, err := app.user.GetContactOrVisitor(contactID, "")
+		if err != nil {
+			return err
+		}
+		if contact.Email.String != "" {
+			return nil
+		}
+	}
+	return envelope.NewError(envelope.InputError, app.i18n.Ts("globals.messages.required", "name", "{globals.terms.email}"), nil)
+}
+
