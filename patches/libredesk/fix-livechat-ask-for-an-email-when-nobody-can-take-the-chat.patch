-  // If user has session token, exclude default name, email and phone fields and Kuraka's last name
+  // If user has session token, exclude default name, email and phone fields and Kuraka's last name.
+  // With nobody available the chat waits, so the email stays: required for new visitors,
+  // optional for returning ones (the server uses their saved email).
+  const waiting = ['wait', 'both'].includes(menuState.offline)
   if (props.excludeDefaultFields) {
-    fields = fields.filter((field) => !['name', 'last_name', 'email', 'phone'].includes(field.key))
+    fields = fields.filter(
+      (field) =>
+        !['name', 'last_name', 'email', 'phone'].includes(field.key) ||
+        (waiting && field.key === 'email')
+    )
+  } else if (waiting) {
+    fields = fields.map((field) => (field.key === 'email' ? { ...field, required: true } : field))
   }
 
   return fields.sort((a, b) => (a.order || 0) - (b.order || 0))
