{
	email {$ACME_EMAIL}
	# Local testing only: CADDY_EXTRA_GLOBAL=local_certs uses Caddy's internal CA.
	{$CADDY_EXTRA_GLOBAL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# Kuraka panel.
{$PANEL_HOST} {
	import security_headers
	reverse_proxy kuraka:8080 {
		# Replace any client-supplied chain: Kuraka rate-limits by this address.
		header_up X-Forwarded-For {remote_host}
	}
}

# Stalwart public HTTP: JMAP, autoconfig, autodiscover, MTA-STS, .well-known.
# The certificate Caddy obtains here is also used by Stalwart for SMTP/IMAP.
{$MAIL_HOST} {
	import security_headers

	# The Stalwart admin interface is never public.
	@admin path /admin* /login*
	handle @admin {
		respond 404
	}
	handle {
		reverse_proxy stalwart:8080
	}
}

# Extra sites: every deploy/sites/*.caddy file is loaded here, so local sites
# survive updates to this file. Static files go under deploy/sites/<name>/ and
# are served from /etc/caddy/sites/<name>. Example for a Libredesk bundle
# generated by Kuraka: run sh install.sh to copy desk.caddy here and reload.
# The app joins kuraka_mail as kuraka-<tenant>-desk.
import /etc/caddy/sites/*.caddy
