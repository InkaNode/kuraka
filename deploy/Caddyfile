{
	email {$ACME_EMAIL}
	order replace after encode
	# Local testing only: CADDY_EXTRA_GLOBAL=local_certs uses Caddy's internal CA.
	{$CADDY_EXTRA_GLOBAL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# App name and upstream; keep addon requests out of the app's proxy.
(kuraka_addon_proxy) {
	handle /_kuraka/addon/* {
		reverse_proxy kuraka:8080
	}
	handle {
		replace {
			match {
				header Content-Type text/html*
			}
			"</head>" `<link rel="stylesheet" href="/_kuraka/addon/{args[0]}.css"><script defer src="/_kuraka/addon/{args[0]}.js"></script></head>`
		}
		reverse_proxy {args[1]} {
			# Go's transport then asks for gzip and decompresses it, so replace sees
			# plain HTML even from upstreams that always send gzip.
			header_up -Accept-Encoding
		}
	}
}

# Kuraka panel.
{$PANEL_HOST} {
	import security_headers
	reverse_proxy kuraka:8080 {
		# Replace any client-supplied chain: Kuraka rate-limits by this address.
		header_up X-Forwarded-For {remote_host}
		# Upstream error responses must also enter handle_errors.
		@maintenance status 502 503 504
		handle_response @maintenance {
			error 503
		}
	}
	handle_errors 502 503 504 {
		import security_headers
		root * /srv
		try_files /maintenance/index.html /maintenance-default.html
		header Retry-After 30
		header Cache-Control no-store
		file_server {
			status 503
		}
	}
}

# Stalwart public HTTP: JMAP, autoconfig, autodiscover, MTA-STS, .well-known.
# The certificate Caddy obtains here is also used by Stalwart for SMTP/IMAP.
{$MAIL_HOST} {
	import security_headers

	# The Stalwart admin interface is never public. /login stays open: it is
	# the OAuth sign-in page of the /account portal.
	@admin path /admin*
	handle @admin {
		respond 404
	}
	# The addon proxy receives plain responses; compress them again here.
	encode zstd gzip
	import kuraka_addon_proxy stalwart stalwart:8080
}

# Extra sites: every deploy/sites/*.caddy file is loaded here, so local sites
# survive updates to this file. Static files go under deploy/sites/<name>/ and
# are served from /etc/caddy/sites/<name>. Example for a Libredesk bundle
# generated by Kuraka: run sh install.sh to copy desk.caddy here and reload.
# The app joins kuraka_mail as kuraka-<tenant>-desk.
import /etc/caddy/sites/*.caddy
