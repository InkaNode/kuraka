# Copy to deploy/.env and edit the first block. setup.sh fills in the rest
# and keeps the file at mode 600. Never commit deploy/.env.

# Panel hostname (DNS A record to this VPS).
PANEL_HOST=panel.example.com
# Mail server hostname (DNS A record to this VPS, Cloudflare proxy OFF; PTR record = this name).
MAIL_HOST=mail.example.com
# First mail domain configured in Stalwart.
MAIL_DOMAIN=example.com
# Let's Encrypt account email.
ACME_EMAIL=admin@example.com
# Kuraka image tag.
KURAKA_VERSION=latest
# Local testing only: set to local_certs to use Caddy's internal CA instead of Let's Encrypt.
CADDY_EXTRA_GLOBAL=

# --- Generated by setup.sh: leave empty ---
KURAKA_SECRET_KEY=
# First-setup only; remove after setup and run `docker compose up -d stalwart`.
STALWART_RECOVERY_ADMIN=
# Stalwart admin user:secret from bootstrap. Rotate after setup.
STALWART_ADMIN=
STALWART_CERTIFICATE_ID=
KURAKA_STALWART_API_KEY=
